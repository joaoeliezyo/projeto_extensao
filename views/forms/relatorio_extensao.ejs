<%- include('../cabecalho', { titulo: 'Relatório de Extensão' }) %>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

  <% const p=projeto || {}; const formatDate=(d)=> {
    if (!d) return '---';
    try {
    const dateObj = new Date(d);
    if (isNaN(dateObj.getTime())) return '---';
    return dateObj.getUTCDate().toString().padStart(2, '0') + '/' +
    (dateObj.getUTCMonth() + 1).toString().padStart(2, '0') + '/' +
    dateObj.getUTCFullYear();
    } catch(e) { return '---'; }
    };
    %>

    <main class="container my-5">
      <section class="card shadow p-4 p-md-5">

        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
          <h1 class="fs-4 fw-bold mb-0">
            <i class="bi bi-file-earmark-text"></i> Relatório de Extensão - <%= p.titulo || '' %>
          </h1>
          <div class="d-flex gap-2">
            <button type="submit" form="form-relatorio" class="btn btn-sm btn-primary">
              <i class="bi bi-save"></i> Salvar
            </button>
            <a href="/projeto_extensao/<%= p.id_projeto %>/relatorio/pdf" class="btn btn-sm btn-success" target="_blank">
              <i class="bi bi-filetype-pdf"></i> Baixar PDF
            </a>
            <a href="/projeto_extensao" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-arrow-left"></i> Voltar
            </a>
          </div>
        </div>

        <!-- ===== DADOS DO PROJETO (readonly) ===== -->
        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-info-circle"></i> Dados do Projeto</h5>

        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Tipo de Extensão</label>
            <div class="form-control bg-light">
              <%= p.tipo_plano_nome || '---' %>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Título</label>
            <div class="form-control bg-light">
              <%= p.titulo || '---' %>
            </div>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Período</label>
            <div class="form-control bg-light">
              <%= formatDate(p.periodo_inicio) %> a <%= formatDate(p.periodo_fim) %>
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Tipo de Ação</label>
            <div class="form-control bg-light">
              <%= (p.tiposAcao && p.tiposAcao.length> 0) ? p.tiposAcao.map(t => t.nome).join(', ') : '---' %>
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Área Temática / Linha Programática</label>
            <div class="form-control bg-light">
              <%= (p.linhas && p.linhas.length> 0) ? p.linhas.map(l => l.nome).join(', ') : '---' %>
            </div>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Carga Horária</label>
            <div class="form-control bg-light">
              <%= p.carga_horaria_total || '---' %> h
            </div>
          </div>
        </div>

        <% if (p.locais && p.locais.length> 0) { %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Local de Execução</label>
            <div class="form-control bg-light" style="height:auto; min-height:38px;">
              <% p.locais.forEach((loc, i)=> { %>
                <%= loc.endereco %> - <%= loc.bairro %>, <%= loc.cidade %>
                      <%= i < p.locais.length - 1 ? '; ' : '' %>
                        <% }) %>
            </div>
          </div>
          <% } %>

            <!-- ===== II - EQUIPE EXECUTORA (readonly) ===== -->
            <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-people"></i> II - Equipe Executora</h5>

            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Coordenador</label>
                <div class="form-control bg-light">
                  <%= p.coordenador_nome || '---' %>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Cursos</label>
                <div class="form-control bg-light">
                  <%= (p.cursos && p.cursos.length> 0) ? p.cursos.map(c => c.nome_curso).join(', ') : '---' %>
                </div>
              </div>
            </div>

            <% if (p.pessoas && p.pessoas.length> 0) { %>
              <div class="mb-3">
                <label class="form-label fw-semibold">Professores / Técnicos</label>
                <div class="form-control bg-light" style="height:auto; min-height:38px;">
                  <% p.pessoas.forEach((pe, i)=> { %>
                    <%= pe.nome %> (<%= pe.papel %>
                        <%= pe.disciplina ? ' - ' + pe.disciplina : '' %>
                          <%= pe.cargahoraria ? ' - ' + pe.cargahoraria + 'h' : '' %>)<%= i < p.pessoas.length - 1
                              ? ', ' : '' %>
                              <% }) %>
                </div>
              </div>
              <% } %>

                <!-- ===== III - PÚBLICO-ALVO E ABRANGÊNCIA (readonly) ===== -->
                <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-person-lines-fill"></i> III - Público-Alvo e Abrangência
                </h5>
                <div class="mb-3">
                  <div class="form-control bg-light">
                    <%= p.publico_alvo_nome || '---' %>
                  </div>
                </div>

                <!-- ===== IV - OBJETIVOS DA AÇÃO (readonly) ===== -->
                <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-bullseye"></i> IV - Objetivos da Ação</h5>
                <div class="mb-3">
                  <div class="form-control bg-light" style="height:auto; min-height:80px; white-space:pre-wrap;">
                    <%- p.objetivo || '---' %>
                  </div>
                </div>

                <!-- ===== VII - ATIVIDADES DESENVOLVIDAS (gerenciavel - FORA do form principal) ===== -->
                <h5 class="fw-bold mt-4 mb-3">
                  <i class="bi bi-calendar-range"></i> VII - Atividades Desenvolvidas
                  <button type="button" class="btn btn-sm btn-outline-primary float-end" style="font-size:0.688rem"
                    onclick="document.getElementById('form-add-cronograma-rel').style.display = document.getElementById('form-add-cronograma-rel').style.display === 'none' ? 'block' : 'none'"><i
                      class="bi bi-plus"></i> Adicionar Atividade</button>
                </h5>
                <% if (p.cronograma && p.cronograma.length> 0) { %>
                  <div class="table-responsive mb-3">
                    <table class="table table-bordered table-striped">
                      <thead class="table-light">
                        <tr>
                          <th>Nº</th>
                          <th>Etapa</th>
                          <th>Data</th>
                          <th>Hora</th>
                          <th>Local</th>
                          <th style="width:60px"></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% p.cronograma.forEach(c=> { %>
                          <tr>
                            <td>
                              <%= c.numero || '' %>
                            </td>
                            <td>
                              <%= c.etapa || '' %>
                            </td>
                            <td>
                              <%= formatDate(c.data) %>
                            </td>
                            <td>
                              <%= c.hora || '' %>
                            </td>
                            <td>
                              <%= c.local || '' %>
                            </td>
                            <td class="d-flex gap-1">
                              <button type="button" class="btn btn-sm btn-outline-secondary"
                                style="font-size: 0.75rem; padding: 2px 5px" title="Editar"
                                onclick="editarCronogramaRel('<%= c.id %>', '<%= c.etapa %>', '<%= formatDate(c.data) %>', '<%= c.hora %>', '<%= c.local %>')">
                                <i class="bi bi-pencil"></i>
                              </button>
                              <form method="POST"
                                action="/projeto_extensao/<%= p.id_projeto %>/cronograma/<%= c.id %>/delete"
                                onsubmit="return confirm('Excluir esta atividade?')">
                                <input type="hidden" name="from" value="relatorio">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                  style="font-size: 0.75rem; padding: 2px 5px" title="Excluir"><i
                                    class="bi bi-trash"></i></button>
                              </form>
                            </td>
                          </tr>
                          <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <% } else { %>
                    <p class="text-muted text-center py-3" style="font-size:0.75rem"><i class="bi bi-info-circle"></i>
                      Nenhuma atividade cadastrada. Clique em "Adicionar Atividade" para incluir.</p>
                    <% } %>
                      <div id="form-add-cronograma-rel"
                        style="display:none; border:1px solid #dee2e6; border-radius:6px; padding:12px; margin-bottom:16px; background:#f9fafb">
                        <form method="POST" action="/projeto_extensao/<%= p.id_projeto %>/cronograma"
                          class="row g-2 align-items-end">
                          <input type="hidden" name="from" value="relatorio">
                          <div class="col-md-4"><label class="form-label" style="font-size:0.688rem">Etapa</label><input
                              name="etapa" class="form-control form-control-sm" placeholder="Descrição da atividade"
                              required style="font-size:0.75rem"></div>
                          <div class="col-md-2"><label class="form-label" style="font-size:0.688rem">Data</label><input
                              name="data" type="date" class="form-control form-control-sm" style="font-size:0.75rem">
                          </div>
                          <div class="col-md-2"><label class="form-label" style="font-size:0.688rem">Hora</label><input
                              name="hora" type="text" class="form-control form-control-sm" placeholder="23:59"
                              pattern="([01]?[0-9]|2[0-3]):[0-5][0-9]" title="Formato 24h (HH:mm)"
                              style="font-size:0.75rem"></div>
                          <div class="col-md-2"><label class="form-label" style="font-size:0.688rem">Local</label><input
                              name="local" class="form-control form-control-sm" placeholder="Sala, Auditório..."
                              style="font-size:0.75rem"></div>
                          <div class="col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100"
                              style="font-size:0.688rem"><i class="bi bi-check-lg"></i> Salvar</button></div>
                        </form>
                      </div>

                      <!-- ===== FORM DO RELATÓRIO (campos editáveis) ===== -->
                      <form method="POST" action="/projeto_extensao/<%= p.id_projeto %>/relatorio"
                        enctype="multipart/form-data" id="form-relatorio">

                        <!-- ===== V - JUSTIFICATIVA (editavel) ===== -->
                        <div class="border rounded p-3 mb-3 bg-white">
                          <h5 class="fw-bold mb-2"><i class="bi bi-journal-text"></i> V - Justificativa</h5>
                          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Apresente a motivação da
                            ação: demanda social identificada, problemas enfrentados, importância para a comunidade.</p>
                          <input type="hidden" name="justificativa" id="hidden-justificativa">
                          <div id="editor-container-justificativa" style="min-height: 150px; background: #fff;">
                            <%- p.justificativa || '' %>
                          </div>
                        </div>

                        <!-- ===== VI - METODOLOGIA (readonly) ===== -->
                        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-diagram-3"></i> VI - Metodologia</h5>
                        <div class="mb-3">
                          <div class="form-control bg-light"
                            style="height:auto; min-height:80px;">
                            <%- p.metodologia || '---' %>
                          </div>
                        </div>

                        <!-- ===== VIII - RESULTADOS ALCANÇADOS (editavel) ===== -->
                        <div class="border rounded p-3 mb-3 bg-white">
                          <h5 class="fw-bold mb-2"><i class="bi bi-check2-circle"></i> VIII - Resultados Alcançados</h5>
                          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Inclua resultados
                            qualitativos (mudanças percebidas) e quantitativos (número de beneficiados, atividades
                            executadas).</p>
                          <input type="hidden" name="resultados_alcancados" id="hidden-resultados-alcancados">
                          <div id="editor-container-resultados-alcancados" style="min-height: 150px; background: #fff;">
                            <%- p.resultados_alcancados || '' %>
                          </div>
                        </div>

                        <!-- ===== IX - AVALIAÇÃO DA AÇÃO (editavel) ===== -->
                        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-chat-left-text"></i> IX - Avaliação da Ação</h5>

                        <div class="border rounded p-3 mb-3 bg-white">
                          <label class="form-label fw-semibold">Avaliação da Comunidade</label>
                          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Como foi coletado o feedback?
                            O que foi positivo? O que pode ser melhorado?</p>
                          <input type="hidden" name="avaliacao_comunidade" id="hidden-avaliacao-comunidade">
                          <div id="editor-container-avaliacao-comunidade" style="min-height: 150px; background: #fff;">
                            <%- p.avaliacao_comunidade || '' %>
                          </div>
                        </div>

                        <div class="border rounded p-3 mb-3 bg-white">
                          <label class="form-label fw-semibold">Avaliação da Equipe</label>
                          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">O que funcionou bem?
                            Dificuldades enfrentadas? Aprendizagens para ações futuras?</p>
                          <input type="hidden" name="avaliacao_equipe" id="hidden-avaliacao-equipe">
                          <div id="editor-container-avaliacao-equipe" style="min-height: 150px; background: #fff;">
                            <%- p.avaliacao_equipe || '' %>
                          </div>
                        </div>

                        <!-- ===== X - PRODUTOS GERADOS (editavel) ===== -->
                        <div class="border rounded p-3 mb-3 bg-white">
                          <h5 class="fw-bold mb-2"><i class="bi bi-box-seam"></i> X - Produtos Gerados</h5>
                          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Materiais didáticos, artigos,
                            cartilhas, vídeos, protótipos. Indicar links ou anexos.</p>
                          <input type="hidden" name="produtos_gerados" id="hidden-produtos-gerados">
                          <div id="editor-container-produtos-gerados" style="min-height: 150px; background: #fff;">
                            <%- p.produtos_gerados || '' %>
                          </div>
                        </div>

                        <!-- ===== XI - VINCULAÇÃO COM OS ODS (editavel) ===== -->
                        <div class="border rounded p-3 mb-3 bg-white">
                          <h5 class="fw-bold mb-2"><i class="bi bi-globe2"></i> XI - Vinculação com os ODS</h5>
                          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Relacione com 1 a 3 ODS da
                            Agenda 2030 da ONU (ex: ODS 4 – Educação de qualidade).</p>
                          <input type="hidden" name="ods" id="hidden-ods">
                          <div id="editor-container-ods" style="min-height: 150px; background: #fff;">
                            <%- p.ods || '' %>
                          </div>
                        </div>

                        <!-- ===== XIII - OBSERVAÇÃO FINAL (editavel) ===== -->
                        <div class="border rounded p-3 mb-3 bg-white">
                          <h5 class="fw-bold mb-2"><i class="bi bi-pencil-square"></i> XIII - Observação Final</h5>
                          <input type="hidden" name="observacao_final" id="hidden-observacao-final">
                          <div id="editor-container-observacao-final" style="min-height: 150px; background: #fff;">
                            <%- p.observacao_final || 'Este relatório atende às diretrizes da Resolução CNE/CES nº 7/2018 e às orientações da política de extensão da instituição, visando demonstrar o impacto social da ação, sua articulação com o ensino e a formação cidadã dos estudantes.' %>
                          </div>
                        </div>

                        <!-- ===== XV - ANEXOS (editavel) ===== -->
                        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-paperclip"></i> XV - Anexos</h5>
                        <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Envie imagens e documentos de
                          suporte (Somente visual no momento)</p>
                        <div class="mb-3">
                          <div class="fm-box" id="fmBox">
                            <!-- DESCRIÇÃO -->
                            <div class="fm-description-wrap">
                              <label class="fm-description-label" for="descriptionField">Descrição</label>
                              <textarea id="descriptionField" name="anexos" class="fm-description-textarea"
                                placeholder="Descreva os anexos ou adicione observações relevantes…"
                                maxlength="1000"><%= p.anexos || '' %></textarea>
                            </div>

                            <div class="fm-toolbar">
                              <button type="button" class="fm-btn" id="btnAddFile" title="Adicionar arquivo"
                                aria-label="Adicionar arquivo">
                                <i class="bi bi-cloud-plus"></i>
                              </button>
                              <button type="button" class="fm-btn" title="Nova pasta" aria-label="Nova pasta"
                                style="opacity:0.45;cursor:default;" tabindex="-1">
                                <i class="bi bi-folder-plus"></i>
                              </button>
                              <button type="button" class="fm-btn secondary" id="btnDownloadAll" title="Baixar todos"
                                aria-label="Baixar todos">
                                <i class="bi bi-download"></i>
                              </button>
                              <input type="file" id="fileInput" name="anexos_files" multiple
                                accept="image/*,.pdf,.xls,.xlsx,.doc,.docx" style="display:none" aria-hidden="true">
                            </div>

                            <!-- Árvore -->
                            <div class="fm-tree" id="fmTree">
                              <div class="fm-folder-row">
                                <span class="fm-toggle">▼</span>
                                <i class="bi bi-folder-fill" style="color:var(--brand);font-size:1.1rem;"></i>
                                <span>Arquivos</span>
                                <span id="totalCounter"
                                  style="font-size:11px;font-family:monospace;color:var(--muted);margin-left:4px;font-weight:400;"></span>
                              </div>
                              <ul class="fm-file-list" id="fileList"></ul>
                            </div>

                            <div class="fm-info-bar">
                              <span>Tamanho máximo por arquivo: <strong>10 MB</strong></span>
                              <span>·</span>
                              <span>Máximo de anexos: <strong>6</strong></span>
                            </div>
                          </div>
                        </div>

                        <div class="toast-container-fm" id="toastContainer" aria-live="assertive"></div>

                        <!-- ===== BOTÕES ===== -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                          <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-save"></i> Salvar
                          </button>
                          <a href="/projeto_extensao/<%= p.id_projeto %>/relatorio/pdf" class="btn btn-sm btn-success"
                            target="_blank">
                            <i class="bi bi-filetype-pdf"></i> Baixar PDF
                          </a>
                          <a href="/projeto_extensao" class="btn btn-sm btn-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar
                          </a>
                        </div>

                      </form>
      </section>
    </main>

    <script>
      // Lógica visual do File Manager
      const MAX_TOTAL = 6;
      const MAX_SIZE = 10 * 1024 * 1024;

      // Carrega os arquivos que já foram salvos no banco
      const arquivosSalvos = <%- JSON.stringify(projeto.arquivos_anexos || []) %>;
      let allFiles = [];

      const fileInput = document.getElementById("fileInput");
      const fileList = document.getElementById("fileList");
      const totalCounter = document.getElementById("totalCounter");
      const fmBox = document.getElementById("fmBox");

      function showToastFM(msg, type = "info", duration = 3500) {
        const icons = { success: "✅", error: "❌", info: "ℹ️" };
        const el = document.createElement("div");
        el.className = `toast-fm ${type}`;
        el.innerHTML = `<span>${icons[type]}</span><span>${msg}</span>`;
        document.getElementById("toastContainer").appendChild(el);
        setTimeout(() => {
          el.style.animation = "toastOut 0.3s ease both";
          setTimeout(() => el.remove(), 300);
        }, duration);
      }

      function formatSizeFm(bytes) {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
        return (bytes / (1024 * 1024)).toFixed(2) + " MB";
      }

      function savedFileIconHTML(anexo) {
        const n = anexo.nome_original.toLowerCase();
        const t = anexo.tipo_arquivo || "";
        if (t.startsWith("image/") || n.endsWith(".png") || n.endsWith(".jpg") || n.endsWith(".jpeg") || n.endsWith(".webp")) {
          return `<img src="${anexo.caminho_arquivo}" alt="miniatura" style="width:22px;height:22px;object-fit:cover;border-radius:3px;border:1px solid var(--line);">`;
        }
        if (t === "application/pdf" || n.endsWith(".pdf")) {
          return `<i class="bi bi-file-earmark-pdf-fill" style="color:#e74c3c;font-size:1.2rem;"></i>`;
        }
        if (t.includes("wordprocessingml") || n.endsWith(".doc") || n.endsWith(".docx")) {
          return `<i class="bi bi-file-earmark-word-fill" style="color:#2b579a;font-size:1.2rem;"></i>`;
        }
        if (t.includes("excel") || t.includes("spreadsheetml") || n.endsWith(".xls") || n.endsWith(".xlsx")) {
          return `<i class="bi bi-file-earmark-excel-fill" style="color:#217346;font-size:1.2rem;"></i>`;
        }
        return `<i class="bi bi-file-earmark-fill" style="color:var(--muted);font-size:1.2rem;"></i>`;
      }

      function fileIconHTML(entry) {
        if (entry.type === "image" && entry.src) {
          return `<img src="${entry.src}" alt="miniatura" style="width:22px;height:22px;object-fit:cover;border-radius:3px;border:1px solid var(--line);">`;
        }
        const n = entry.file.name.toLowerCase();
        const t = entry.file.type;
        if (t === "application/pdf" || n.endsWith(".pdf")) {
          return `<i class="bi bi-file-earmark-pdf-fill" style="color:#e74c3c;font-size:1.2rem;"></i>`;
        }
        if (t.includes("wordprocessingml") || n.endsWith(".doc") || n.endsWith(".docx")) {
          return `<i class="bi bi-file-earmark-word-fill" style="color:#2b579a;font-size:1.2rem;"></i>`;
        }
        if (t.includes("excel") || t.includes("spreadsheetml") || n.endsWith(".xls") || n.endsWith(".xlsx")) {
          return `<i class="bi bi-file-earmark-excel-fill" style="color:#217346;font-size:1.2rem;"></i>`;
        }
        return `<i class="bi bi-file-earmark-fill" style="color:var(--muted);font-size:1.2rem;"></i>`;
      }

      function sincronizarInputArquivos() {
        if (!fileInput) return;
        const dataTransfer = new DataTransfer();
        allFiles.forEach(entry => dataTransfer.items.add(entry.file));
        fileInput.files = dataTransfer.files;
      }

      function renderAll() {
        fileList.innerHTML = "";
        const total = arquivosSalvos.length + allFiles.length;
        totalCounter.textContent = total > 0 ? `(${total})` : "";

        if (total === 0) {
          const li = document.createElement("li");
          li.className = "fm-empty";
          li.textContent = "Nenhum arquivo adicionado.";
          fileList.appendChild(li);
          return;
        }

        // 1. Renderizar arquivos que já estão salvos no servidor
        arquivosSalvos.forEach((anexo) => {
          const li = document.createElement("li");
          li.className = "fm-file-item";
          li.innerHTML = `
        <div class="fm-file-icon">${savedFileIconHTML(anexo)}</div>
        <span class="fm-file-name" title="${anexo.nome_original}">
          <a href="${anexo.caminho_arquivo}" target="_blank" style="text-decoration:none;color:inherit;">
            ${anexo.nome_original} <i class="bi bi-box-arrow-up-right" style="font-size:0.75rem;opacity:0.7"></i>
          </a>
        </span>
        <span class="fm-file-size">${formatSizeFm(anexo.tamanho_bytes || 0)}</span>
        <button type="button" class="fm-file-remove" onclick="removerAnexoSalvo('${anexo.id_projeto}', '${anexo.id_anexo}', 'relatorio')" aria-label="Remover ${anexo.nome_original}" title="Remover"><i class="bi bi-trash"></i></button>
      `;
          fileList.appendChild(li);
        });

        // 2. Renderizar arquivos novos selecionados para upload
        allFiles.forEach((entry, index) => {
          const li = document.createElement("li");
          li.className = "fm-file-item";
          li.innerHTML = `
        <div class="fm-file-icon">${fileIconHTML(entry)}</div>
        <span class="fm-file-name" title="${entry.file.name}">${entry.file.name} <span class="badge bg-warning text-dark" style="font-size:0.6rem;padding:2px 4px;margin-left:4px;">Pendente</span></span>
        <span class="fm-file-size">${formatSizeFm(entry.file.size)}</span>
        <button type="button" class="fm-file-remove" onclick="removeFile(${index})" aria-label="Remover ${entry.file.name}" title="Remover"><i class="bi bi-trash"></i></button>
      `;
          fileList.appendChild(li);
        });
      }

      function handleAllFiles(files) {
        for (const file of files) {
          if (arquivosSalvos.length + allFiles.length >= MAX_TOTAL) {
            showToastFM(`Máximo de ${MAX_TOTAL} anexos atingido.`, "error");
            break;
          }
          if (file.size > MAX_SIZE) {
            showToastFM(`"${file.name}" excede 10 MB.`, "error");
            continue;
          }

          const duplicateSaved = arquivosSalvos.some(e => e.nome_original === file.name && e.tamanho_bytes === file.size);
          const duplicateNew = allFiles.some(e => e.file.name === file.name && e.file.size === file.size);
          if (duplicateSaved || duplicateNew) {
            showToastFM(`"${file.name}" já foi adicionado.`, "info", 2500);
            continue;
          }
          const isImage = file.type.startsWith("image/");
          const entry = { file, type: isImage ? "image" : "doc", src: null };
          allFiles.push(entry);

          if (isImage) {
            const reader = new FileReader();
            reader.onload = (ev) => { entry.src = ev.target.result; renderAll(); };
            reader.readAsDataURL(file);
          }
        }
        sincronizarInputArquivos();
        renderAll();
      }

      window.removeFile = function (index) {
        const name = allFiles[index].file.name;
        allFiles.splice(index, 1);
        sincronizarInputArquivos();
        renderAll();
        showToastFM(`"${name}" removido.`, "info", 2000);
      };

      window.removerAnexoSalvo = function (idProjeto, idAnexo, from) {
        if (!confirm('Deseja remover este anexo?')) return;

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/projeto_extensao/${idProjeto}/anexo/${idAnexo}/delete`;

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'from';
        input.value = from;

        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      };

      fmBox.addEventListener("dragover", (e) => { e.preventDefault(); fmBox.classList.add("dragover"); });
      fmBox.addEventListener("dragleave", (e) => { if (!fmBox.contains(e.relatedTarget)) fmBox.classList.remove("dragover"); });
      fmBox.addEventListener("drop", (e) => { e.preventDefault(); fmBox.classList.remove("dragover"); handleAllFiles(e.dataTransfer.files); });

      document.getElementById("btnAddFile").addEventListener("click", () => fileInput.click());
      fileInput.addEventListener("change", (e) => handleAllFiles(e.target.files));

      document.getElementById("btnDownloadAll").addEventListener("click", () => {
        if (arquivosSalvos.length === 0 && allFiles.length === 0) { showToastFM("Nenhum arquivo para baixar.", "info"); return; }

        arquivosSalvos.forEach(anexo => {
          const a = Object.assign(document.createElement("a"), { href: anexo.caminho_arquivo, download: anexo.nome_original });
          a.click();
        });

        allFiles.forEach(entry => {
          const url = entry.src || URL.createObjectURL(entry.file);
          const a = Object.assign(document.createElement("a"), { href: url, download: entry.file.name });
          a.click();
          if (!entry.src) setTimeout(() => URL.revokeObjectURL(url), 1000);
        });
      });

      renderAll();

      window.editarCronogramaRel = function (id, etapa, data, hora, local) {
        const div = document.getElementById('form-add-cronograma-rel');
        const form = div.querySelector('form');
        div.style.display = 'block';
        form.action = form.action.replace(/\/cronograma(\/.*)?$/, '') + '/cronograma/' + id + '/edit';
        form.querySelector('[name="etapa"]').value = etapa;
        if (data && data !== '---') {
          const parts = data.split('/');
          if (parts.length === 3) {
            form.querySelector('[name="data"]').value = `${parts[2]}-${parts[1]}-${parts[0]}`;
          }
        }
        form.querySelector('[name="hora"]').value = hora;
        form.querySelector('[name="local"]').value = local;
        form.querySelector('button[type="submit"]').innerHTML = '<i class="bi bi-check-lg"></i> Salvar';
        div.scrollIntoView({ behavior: 'smooth' });
      };
    </script>

    <!-- Quill Editor JS & Setup -->
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
      const quillConfig = {
        theme: 'snow',
        modules: {
          toolbar: [
            ['bold', 'italic', 'underline', 'strike'],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            [{ 'script': 'sub'}, { 'script': 'super' }],
            [{ 'indent': '-1'}, { 'indent': '+1' }],
            [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
            [{ 'color': [] }, { 'background': [] }],
            [{ 'align': [] }],
            ['clean']
          ]
        }
      };

      // Inicializa os Editores Quill
      const quillJustificativa = new Quill('#editor-container-justificativa', quillConfig);
      const quillResultados = new Quill('#editor-container-resultados-alcancados', quillConfig);
      const quillAvaliacaoComunidade = new Quill('#editor-container-avaliacao-comunidade', quillConfig);
      const quillAvaliacaoEquipe = new Quill('#editor-container-avaliacao-equipe', quillConfig);
      const quillProdutos = new Quill('#editor-container-produtos-gerados', quillConfig);
      const quillOds = new Quill('#editor-container-ods', quillConfig);
      const quillObservacao = new Quill('#editor-container-observacao-final', quillConfig);

      // Copia o conteúdo para os inputs ocultos antes do submit
      const formRelatorio = document.getElementById('form-relatorio');
      if (formRelatorio) {
        formRelatorio.addEventListener('submit', function(e) {
          const editors = [
            { quill: quillJustificativa, hiddenId: 'hidden-justificativa' },
            { quill: quillResultados, hiddenId: 'hidden-resultados-alcancados' },
            { quill: quillAvaliacaoComunidade, hiddenId: 'hidden-avaliacao-comunidade' },
            { quill: quillAvaliacaoEquipe, hiddenId: 'hidden-avaliacao-equipe' },
            { quill: quillProdutos, hiddenId: 'hidden-produtos-gerados' },
            { quill: quillOds, hiddenId: 'hidden-ods' },
            { quill: quillObservacao, hiddenId: 'hidden-observacao-final' }
          ];

          editors.forEach(item => {
            const hiddenInput = document.getElementById(item.hiddenId);
            if (hiddenInput) {
              let htmlContent = item.quill.root.innerHTML;
              if (htmlContent === '<p><br></p>') {
                htmlContent = '';
              }
              hiddenInput.value = htmlContent;
            }
          });
        });
      }
    </script>

