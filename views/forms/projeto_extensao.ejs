<%- include('../cabecalho', { titulo: isEdit ? 'Editar Projeto' : 'Cadastrar Projeto' }) %>
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<% const registro = projeto_extensao || {}; %>
<% const registroId = registro.id_projeto; %>
<% const listaTipoPlanos = Array.isArray(tipoPlanos) ? tipoPlanos : []; %>
<% const listaPublicosAlvo = Array.isArray(publicosAlvo) ? publicosAlvo : []; %>
<% const listaTiposAcao = Array.isArray(todosTiposAcao) ? todosTiposAcao : []; %>
<% const listaLinhas = Array.isArray(todasLinhas) ? todasLinhas : []; %>
<% const tiposAcaoSel = Array.isArray(relTiposAcao) ? relTiposAcao.map(r => r.id_acao || r.id_tipo_acao) : []; %>
<% const linhasSel = Array.isArray(relLinhas) ? relLinhas.map(r => r.id_linha) : []; %>
<% const anexosExistentes = typeof anexos !== 'undefined' && Array.isArray(anexos) ? anexos : []; %>

<main class="container my-5">
  <section class="card shadow p-4 p-md-5">

    <h1 class="fs-4 fw-bold mb-1">
      <i class="bi bi-briefcase"></i> <%= isEdit ? 'Editar Projeto de Extensão' : 'Cadastrar Atividade de Extensão' %>
    </h1>
    <p class="text-muted mb-4" style="font-size:0.75rem">Preencha os campos seguindo a ordem do Plano de Extensão UNI-CET</p>

    <form method="POST"
    id="form-projeto"
    action="<%= isEdit && registroId ? '/projeto_extensao/' + registroId + '/edit' : '/projeto_extensao/cadastrar' %>"
    enctype="multipart/form-data"
    onsubmit="prepararEnvio()">

      <input type="hidden" name="dadosCursos" id="dadosCursos">

      <!-- ===== TIPO DE EXTENSÃO ===== -->
      <div class="border rounded p-3 mb-4 bg-light">
        <h6 class="fw-bold mb-3"><i class="bi bi-tag"></i> Tipo de Extensão</h6>
        <label class="form-label visually-hidden" for="campo-tipo-plano">Tipo de Extensão</label>
        <select name="id_tipo_plano" id="campo-tipo-plano" class="form-select" required>
          <option value="">Selecione o tipo</option>
          <% listaTipoPlanos.forEach(item => { %>
            <option value="<%= item.id_tipo_plano %>" <%= registro.id_tipo_plano == item.id_tipo_plano ? 'selected' : '' %>><%= item.descricao %></option>
          <% }) %>
        </select>
      </div>

      <!-- ===== I - IDENTIFICAÇÃO ===== -->
      <div class="border rounded p-3 mb-4">
        <h6 class="fw-bold mb-3"><i class="bi bi-1-circle"></i> I - Identificação</h6>

        <div class="mb-3">
          <label class="form-label" for="campo-titulo">Título do Projeto <span class="text-danger">*</span></label>
          <input name="titulo" id="campo-titulo" class="form-control" value="<%= registro.titulo || '' %>" required placeholder="Nome completo do projeto de extensão">
        </div>

        <!-- Linha Programática -->
        <div class="mb-3">
          <label class="form-label">Linha Programática / Programa</label>
          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Selecione uma ou mais linhas programáticas</p>
          <div class="row">
            <% listaLinhas.forEach(item => { %>
              <div class="col-md-3 col-6 mb-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="linha_programatica_ids" value="<%= item.id_linha %>" id="linha_<%= item.id_linha %>"
                    <%= linhasSel.includes(item.id_linha) ? 'checked' : '' %>>
                  <label class="form-check-label" for="linha_<%= item.id_linha %>" style="font-size:0.875rem"><%= item.nome %></label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Tipo de Ação -->
        <div class="mb-3">
          <label class="form-label">Tipo de Ação</label>
          <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Selecione o tipo de ação extensionista</p>
          <div class="row">
            <% listaTiposAcao.forEach(item => { %>
              <div class="col-md-4 col-6 mb-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="tipo_acao_ids" value="<%= item.id_tipo_acao %>" id="acao_<%= item.id_tipo_acao %>"
                    <%= tiposAcaoSel.includes(item.id_tipo_acao) ? 'checked' : '' %>>
                  <label class="form-check-label" for="acao_<%= item.id_tipo_acao %>" style="font-size:0.875rem"><%= item.nome %></label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Período -->
        <div class="row mb-3">
          <div class="col-md-4">
            <label class="form-label" for="campo-inicio">Período - Início</label>
            <% 
               let dataInicio = '';
               if (registro.periodo_inicio) {
                 const d = new Date(registro.periodo_inicio);
                 if (!isNaN(d.getTime())) dataInicio = d.toISOString().split('T')[0];
               }
            %>
            <input type="date" name="periodo_inicio" id="campo-inicio" class="form-control" value="<%= dataInicio %>">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="campo-fim">Período - Fim</label>
            <% 
               let dataFim = '';
               if (registro.periodo_fim) {
                 const d = new Date(registro.periodo_fim);
                 if (!isNaN(d.getTime())) dataFim = d.toISOString().split('T')[0];
               }
            %>
            <input type="date" name="periodo_fim" id="campo-fim" class="form-control" value="<%= dataFim %>">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="campo-ch">Carga Horária Total</label>
            <input type="number" name="carga_horaria_total" id="campo-ch" min="0" class="form-control"
              value="<%= registro.carga_horaria_total || '' %>" placeholder="Calculado automaticamente" readonly style="background-color: #e9ecef; cursor: not-allowed;">
            <small class="text-muted" style="font-size:0.7rem">Soma da CH de todos os professores</small>
          </div>
        </div>

        <!-- Público-Alvo -->
        <div class="mb-3">
          <label class="form-label" for="campo-publico">Público-Alvo</label>
          <select name="id_publico_alvo" id="campo-publico" class="form-select">
            <option value="">Selecione</option>
            <% listaPublicosAlvo.forEach(item => { %>
              <option value="<%= item.id_publico_alvo %>" <%= registro.id_publico_alvo == item.id_publico_alvo ? 'selected' : '' %>><%= item.descricao %></option>
            <% }) %>
          </select>
          <small class="text-muted" style="font-size:0.7rem">Perfil da clientela alcançada pelo projeto</small>
        </div>
      </div>

      <!-- ===== CURSOS E EQUIPE ===== -->
      <div class="border rounded p-3 mb-4">
        <h6 class="fw-bold mb-3"><i class="bi bi-people"></i> Cursos Envolvidos e Equipe</h6>
        <p class="text-muted" style="font-size:0.7rem;margin-bottom:12px">Adicione os cursos vinculados ao projeto e selecione os professores responsáveis de cada curso</p>
        <div id="lista-global-cursos"></div>
        <button type="button" class="btn btn-primary btn-sm w-100" onclick="adicionarBlocoCurso()">
          <i class="bi bi-plus-circle"></i> Adicionar Curso
        </button>
      </div>

      <!-- ===== II - OBJETIVOS ===== -->
      <div class="border rounded p-3 mb-4 bg-white">
        <h6 class="fw-bold mb-3"><i class="bi bi-2-circle"></i> II - Objetivo(s)</h6>
        <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Estabeleça os objetivos usando verbos como: desenvolver, organizar, capacitar, demonstrar, contribuir, colaborar, valorizar, aplicar.</p>
        <input type="hidden" name="objetivo" id="hidden-objetivo">
        <div id="editor-container-objetivo" style="min-height: 200px; background: #fff;">
          <%- registro.objetivo || '' %>
        </div>
      </div>

      <!-- ===== III - METODOLOGIA ===== -->
      <div class="border rounded p-3 mb-4 bg-white">
        <h6 class="fw-bold mb-3"><i class="bi bi-3-circle"></i> III - Metodologia</h6>
        <p class="text-muted" style="font-size:0.7rem;margin-bottom:6px">Descreva os procedimentos, o roteiro claro e detalhado das etapas e atividades a serem executadas.</p>
        <input type="hidden" name="metodologia" id="hidden-metodologia">
        <div id="editor-container-metodologia" style="min-height: 200px; background: #fff;">
          <%- registro.metodologia || '' %>
        </div>
      </div>

            <!-- ===== IV - ANEXOS ===== -->
      <div class="border rounded p-3 mb-4">
              <h6 class="fw-bold mb-3"><i class="bi bi-paperclip"></i> IV - Anexos</h6>
              <p class="text-muted" style="font-size:0.7rem;margin-bottom:10px">
                Adicione imagens e documentos de suporte do projeto. Máximo de 20 arquivos, com até 10 MB por arquivo.
              </p>
      
              <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddFile">
                  <i class="bi bi-plus-circle"></i> Adicionar arquivos
                </button>
      
                <button type="button" class="btn btn-outline-danger btn-sm" id="btnClearFiles">
                  <i class="bi bi-x-circle"></i> Limpar lista
                </button>
              </div>
      
              <input
              type="file"
              id="fileInput"
              name="anexos"
              multiple
              accept=".jpg,.jpeg,.png,image/jpeg,image/png,.pdf,.doc,.docx,.xls,.xlsx"
              style="display:none"
            >
      
              <div class="border rounded bg-light">
                <div class="px-3 py-2 border-bottom bg-white d-flex justify-content-between align-items-center">
                  <span class="fw-semibold" style="font-size:0.813rem">Arquivos selecionados</span>
                  <span id="totalCounter" class="text-muted" style="font-size:0.75rem">Nenhum arquivo</span>
                </div>
      
                <ul id="fileList" class="list-group list-group-flush"></ul>
              </div>
      
              <small class="text-muted d-block mt-2" style="font-size:0.7rem">
                Tipos aceitos: JPG, JPEG, PNG, PDF, DOC, DOCX, XLS e XLSX.
              </small>


              <% if (isEdit) { %>
                <div class="mt-3">
                  <h6 class="fw-semibold mb-2" style="font-size:0.9rem">
                    <i class="bi bi-folder2-open"></i> Anexos já salvos
                  </h6>
              
                  <% if (anexosExistentes.length > 0) { %>
                    <ul class="list-group">
                      <% anexosExistentes.forEach(anexo => { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div>
                            <i class="bi bi-paperclip"></i>
                            <a href="<%= anexo.caminho_arquivo %>" target="_blank">
                              <%= anexo.nome_original %>
                            </a>
                          </div>
              
                          <div class="d-flex align-items-center gap-2">
                            <small class="text-muted"><%= anexo.tipo_arquivo || 'arquivo' %></small>
              
                            <button
                            type="button"
                            class="btn btn-outline-danger btn-sm"
                            onclick="removerAnexoSalvo('<%= registroId %>', '<%= anexo.id_anexo %>', 'edit')">
                            <i class="bi bi-trash"></i>
                          </button>
                          </div>
                        </li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <div class="text-muted" style="font-size:0.8rem">
                      Nenhum anexo salvo ainda.
                    </div>
                  <% } %>
                </div>
              <% } %>





      </div>

      <!-- ===== AÇÕES ===== -->
      <div class="d-flex justify-content-end gap-2">
        <a href="/projeto_extensao" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left"></i> Voltar</a>
        <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-check-lg"></i> Salvar Projeto</button>
      </div>

    </form>
  </section>
</main>


<script id="cursos-data" type="application/json">
  <%- JSON.stringify(typeof cursos !== 'undefined' ? cursos : []) %>
</script>

<script id="cursos-selecionados-data" type="application/json">
  <%- JSON.stringify(typeof cursosPreSelecionados !== 'undefined' ? cursosPreSelecionados : []) %>
</script>
<script src="/js/projeto_extensao.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
  // Inicializar o Quill Editor para o campo Objetivo
  var quillObjetivo = new Quill('#editor-container-objetivo', {
    theme: 'snow',
    modules: {
      toolbar: [
        ['bold', 'italic', 'underline', 'strike'],        // toggled buttons
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'script': 'sub'}, { 'script': 'super' }],      // superscript/subscript
        [{ 'indent': '-1'}, { 'indent': '+1' }],          // outdent/indent
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        [{ 'color': [] }, { 'background': [] }],          // dropdown with defaults from theme
        [{ 'align': [] }],
        ['clean']                                         // remove formatting button
      ]
    }
  });

  // Inicializar o Quill Editor para o campo Metodologia
  var quillMetodologia = new Quill('#editor-container-metodologia', {
    theme: 'snow',
    modules: {
      toolbar: [
        ['bold', 'italic', 'underline', 'strike'],        // toggled buttons
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'script': 'sub'}, { 'script': 'super' }],      // superscript/subscript
        [{ 'indent': '-1'}, { 'indent': '+1' }],          // outdent/indent
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        [{ 'color': [] }, { 'background': [] }],          // dropdown with defaults from theme
        [{ 'align': [] }],
        ['clean']                                         // remove formatting button
      ]
    }
  });

  // Antes do envio do formulário, copia o conteúdo em HTML do editor Quill para o campo oculto
  var formProjeto = document.getElementById('form-projeto');
  if (formProjeto) {
    formProjeto.addEventListener('submit', function(e) {
      // Objetivo
      var hiddenObjetivo = document.getElementById('hidden-objetivo');
      var htmlObj = quillObjetivo.root.innerHTML;
      if (htmlObj === '<p><br></p>') {
        htmlObj = '';
      }
      hiddenObjetivo.value = htmlObj;

      // Metodologia
      var hiddenMetodologia = document.getElementById('hidden-metodologia');
      var htmlMet = quillMetodologia.root.innerHTML;
      if (htmlMet === '<p><br></p>') {
        htmlMet = '';
      }
      hiddenMetodologia.value = htmlMet;
    });
  }
</script>
<%- include('../rodape') %>
