<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório da Atividade de Extensão – UNI-CET</title>
  <link rel="stylesheet" href="/css/pdf.css">
</head>

<body>

  <% const p=projeto || {}; const formatDate=(d)=> {
    if (!d) return '___/___/______';
    try {
    const dt = new Date(d);
    const dd = String(dt.getDate()).padStart(2, '0');
    const mm = String(dt.getMonth() + 1).padStart(2, '0');
    const yyyy = dt.getFullYear();
    return dd + '/' + mm + '/' + yyyy;
    } catch(e) { return '___/___/______'; }
    };
    const safe = (val) => val || '';
    const maskCpf = (cpf) => {
    if (!cpf) return '***.***.***-**';
    const clean = cpf.replace(/\D/g, '');
    if (clean.length !== 11) return cpf;
    // Show only first three digits and last two digits
    return `${clean.substring(0,3)}.***-${clean.substring(9,11)}`;
    };
    const formatDataHora = (data) => {
    if (!data) return '';
    const dObj = new Date(data);
    if (Number.isNaN(dObj.getTime())) return data;
    return dObj.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });
    };
    const getPessoasStr = () => {
    if (!p.pessoas || p.pessoas.length === 0) return '';
    return p.pessoas.map(pe => pe.nome + ' (' + pe.papel + (pe.disciplina ? ' - ' + pe.disciplina : '') +
    (pe.cargahoraria ? ' - ' + pe.cargahoraria + 'h' : '') + ')').join(', ');
    };

    // Helpers para data de autenticação
    const dataRef = p.created_at ? new Date(p.created_at) : new Date();
    const authDia = String(dataRef.getDate()).padStart(2, '0');
    const meses =
    ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
    const authMes = meses[dataRef.getMonth()];
    const authAnoStr = String(dataRef.getFullYear()).slice(-2);
    %>

    <!-- ================= PÁGINA 1 ================= -->
    <div class="page">
      <div class="header-container">
        <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
          <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
          <% } else { %>
            <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
            <% } %>
              <div class="header-text">
                <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
              </div>
      </div>

      <div class="doc-title-container">
        <div class="doc-title">RELATÓRIO DA ATIVIDADE DE EXTENSÃO</div>
      </div>

      <div class="form-row">
        <div class="form-label">TIPO DE EXTENSÃO:</div>
        <div class="form-line pdf-bold-12">
          <%= safe(p.tipo_plano_nome) %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-label">TÍTULO DA AÇÃO EXTENSIONISTA:</div>
        <div class="form-line">
          <%= safe(p.titulo) %>
        </div>
      </div>
      <div class="form-row mb-3">
        <div class="form-label">DATA:</div>
        <div class="form-line">
          <%= formatDate(p.created_at || new Date()) %>
        </div>
      </div>

      <div class="section-title">I - IDENTIFICAÇÃO DA AÇÃO</div>
      <div class="form-row">
        <div class="form-label">TIPO DE AÇÃO:</div>
        <div class="form-line">
          <%= (p.tiposAcao && p.tiposAcao.length> 0) ? p.tiposAcao.map(t => t.nome).join(', ') : '___' %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-label">ÁREA TEMÁTICA:</div>
        <div class="form-line">___</div>
      </div>
      <div class="form-row">
        <div class="form-label">LINHA PROGRAMÁTICA:</div>
        <div class="form-line">
          <%= (p.linhas && p.linhas.length> 0) ? p.linhas.map(l => l.nome).join(', ') : '___' %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-label">CARGA HORÁRIA TOTAL DA AÇÃO:</div>
        <div class="form-line">
          <%= p.carga_horaria_total ? p.carga_horaria_total + ' horas' : '___' %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-label">LOCAL:</div>
        <div class="form-line">
          <% if (p.locais && p.locais.length> 0) { %>
            <% p.locais.forEach((loc, i)=> { %><%= loc.endereco %> - <%= loc.bairro %>, <%= loc.cidade %>
                    <%= i < p.locais.length - 1 ? '; ' : '' %>
                      <% }) %>
                        <% } %>
        </div>
      </div>

      <div class="section-title">II - COORDENAÇÃO E EQUIPE DE TRABALHO</div>
      <div class="form-row">
        <div class="form-label">COORDENADOR DA AÇÃO:</div>
        <div class="form-line">
          <%= safe(p.coordenador_nome) %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-label">CURSO(S) VINCULADO(S):</div>
        <div class="form-line">
          <%= safe(p.cursos) %>
        </div>
      </div>
      <div class="form-block-container">
        <div class="form-label">EQUIPE DOCENTE E/OU TÉCNICA:</div>
        <div class="form-value-block pdf-min-h-60">
          <%= getPessoasStr() %>
        </div>
      </div>
      <div class="form-block-container">
        <div class="form-label">ESTUDANTES ENVOLVIDOS:</div>
        <div class="form-value-block pdf-min-h-60"></div>
      </div>
      <div class="form-block-container">
        <div class="form-label">OUTROS PARTICIPANTES:</div>
        <div class="form-value-block pdf-min-h-40"></div>
      </div>

      <div class="section-title">III - PÚBLICO-ALVO E ABRANGÊNCIA</div>
      <div class="form-row">
        <div class="form-label">PERFIL DO PÚBLICO ATENDIDO:</div>
        <div class="form-line">
          <%= safe(p.publico_alvo_nome) %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-label">NÚMERO DE PARTICIPANTES EXTERNOS:</div>
        <div class="form-line"></div>
      </div>
      <div class="form-row">
        <div class="form-label">INSTITUIÇÕES/PARCEIROS ENVOLVIDOS:</div>
        <div class="form-line">
          <% if (p.instituicoes && p.instituicoes.length> 0) { %>
            <% p.instituicoes.forEach((inst, i)=> { %><%= inst.nome %> (<%= inst.sigla %>)<%= i < p.instituicoes.length
                    - 1 ? '; ' : '' %>
                    <% }) %>
                      <% } %>
        </div>
      </div>
    </div>

    <!-- ================= PÁGINA 2 ================= -->
    <div class="page">
      <div class="header-container">
        <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
          <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
          <% } else { %>
            <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
            <% } %>
              <div class="header-text">
                <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
              </div>
      </div>

      <div class="section-title">IV - OBJETIVOS DA AÇÃO</div>
      <div class="form-block-container">
        <div class="form-label">OBJETIVO GERAL:</div>
        <div class="form-value-block pdf-min-h-60">
          <%- safe(p.objetivo) %>
        </div>
      </div>
      <div class="form-block-container">
        <div class="form-label">OBJETIVOS ESPECÍFICOS:</div>
        <div class="form-value-block pdf-min-h-100"></div>
      </div>

      <div class="section-title">V - JUSTIFICATIVA</div>
      <div class="form-block-container">
        <div class="form-value-block pdf-min-h-160">
          <%- safe(p.justificativa) %>
        </div>
      </div>

      <div class="section-title">VI - METODOLOGIA</div>
      <div class="form-block-container">
        <div class="form-value-block pdf-min-h-180">
          <%- safe(p.metodologia) %>
        </div>
      </div>

      <div class="section-title">VII - ATIVIDADES DESENVOLVIDAS</div>
      <table>
        <thead>
          <tr>
            <th class="pdf-col-15">Data</th>
            <th class="pdf-col-40">Atividade Realizada</th>
            <th class="pdf-col-25">Local</th>
            <th class="pdf-col-20">Participantes Envolvidos</th>
          </tr>
        </thead>
        <tbody>
          <% if (p.cronograma && p.cronograma.length> 0) { %>
            <% p.cronograma.forEach(c=> { %>
              <tr>
                <td class="text-center">
                  <%= formatDate(c.data) %>
                </td>
                <td>
                  <%= c.etapa %>
                </td>
                <td>
                  <%= c.local %>
                </td>
                <td></td>
              </tr>
              <% }) %>
                <% } else { %>
                  <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                  </tr>
                  <% } %>
        </tbody>
      </table>
    </div>

    <!-- ================= PÁGINA 3 ================= -->
    <div class="page">
      <div class="header-container">
        <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
          <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
          <% } else { %>
            <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
            <% } %>
              <div class="header-text">
                <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
              </div>
      </div>

      <div class="section-title">VIII - RESULTADOS ALCANÇADOS</div>
      <div class="form-block-container">
        <div class="form-value-block pdf-min-h-250">
          <%- safe(p.resultados_alcancados) %>
        </div>
      </div>

      <div class="section-title">IX - AVALIAÇÃO DA AÇÃO</div>
      <div class="form-block-container">
        <div class="form-label">Avaliação da comunidade/público participante:</div>
        <div class="form-value-block pdf-min-h-140">
          <%- safe(p.avaliacao_comunidade) %>
        </div>
      </div>
      <div class="form-block-container">
        <div class="form-label">Avaliação interna da equipe executora:</div>
        <div class="form-value-block pdf-min-h-140">
          <%- safe(p.avaliacao_equipe) %>
        </div>
      </div>

      <div class="section-title">X - PRODUTOS GERADOS (SE HOUVER)</div>
      <div class="form-block-container">
        <div class="form-value-block pdf-min-h-110">
          <%- safe(p.produtos_gerados) %>
        </div>
      </div>
    </div>

    <!-- ================= PÁGINA 4 ================= -->
    <div class="page">
      <div class="header-container">
        <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
          <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
          <% } else { %>
            <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
            <% } %>
              <div class="header-text">
                <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
              </div>
      </div>

      <div class="section-title">XI - VINCULAÇÃO COM OS ODS (Agenda 2030)</div>
      <div class="form-block-container">
        <div class="form-value-block pdf-min-h-90">
          <%- safe(p.ods) %>
        </div>
      </div>

      <div class="section-title">XII - CARGA HORÁRIA TOTAL</div>
      <table>
        <thead>
          <tr>
            <th class="pdf-col-70">Atividade</th>
            <th class="pdf-col-30">Carga Horária (h)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Ação de Extensão</td>
            <td class="text-center">
              <%= p.carga_horaria_total || '0' %> h
            </td>
          </tr>
          <tr>
            <td class="text-right fw-bold pe-2">Total</td>
            <td class="text-center fw-bold">
              <%= p.carga_horaria_total || '0' %> h
            </td>
          </tr>
        </tbody>
      </table>

      <div class="section-title">XIII - OBSERVAÇÃO FINAL</div>
      <p class="pdf-text-justify">
        Este relatório atende às diretrizes da Resolução CNE/CES nº 7/2018 e às orientações da política de extensão da
        instituição, visando demonstrar o impacto social da ação, sua articulação com o ensino e a formação cidadã dos
        estudantes.
        <br><br>
        <%- safe(p.observacao_final) %>
      </p>

      <div class="section-title pdf-auth-section">XIV - AUTENTICAÇÃO</div>
      <div class="date-row">
        Teresina,
        <span class="pdf-date-blank-35">
          <%= authDia %>
        </span> de
        <span class="pdf-date-blank-90">
          <%= authMes %>
        </span> de
        20<span class="pdf-date-blank-30">
          <%= authAnoStr %>
        </span>.
      </div>

      <div class="pdf-auth-section">
        <!-- 1. Área dos Professores -->
        <div class="pdf-auth-heading">
          Professor(es)
        </div>
        <% if (p.assinaturasProfessoresRelatorio && p.assinaturasProfessoresRelatorio.length> 0) { %>
          <div class="pdf-auth-list">
            <% p.assinaturasProfessoresRelatorio.forEach(ass=> { %>
              <div class="assinatura-box pdf-auth-card">
                <!-- Imagem Unicet -->
                <div>
                  <img src="<%= logoSrc %>" alt="Unicet" class="pdf-auth-logo">
                </div>
                <!-- Nome e Código de Validação -->
                <div class="pdf-auth-info">
                  <p class="pdf-auth-title">
                    <%= ass.nome %>
                  </p>
                  <p class="pdf-auth-meta">
                    Código de validação:<br>
                    <strong class="pdf-auth-hash">
                      <%= ass.Assinatura %>
                    </strong>
                  </p>
                </div>
                <!-- QR Code -->
                <div>
                  <% const url_validacao=baseUrl + '/validar?codigo=' + ass.Assinatura; %>
                    <img
                      src="https://api.qrserver.com/v1/create-qr-code/?size=70x70&data=<%= encodeURIComponent(url_validacao) %>"
                      alt="QR Code de Validação" class="pdf-auth-qr">
                </div>
              </div>
              <% }) %>
          </div>
          <% } else { %>
            <div class="sig-wrapper pdf-sig-wrapper">
              <div class="sig-container">
                <div class="sig-line"></div>
                <div class="sig-label">Docente responsável</div>
                <div class="pdf-sig-meta">
                  <%= safe(p.coordenador_nome) %>
                </div>
              </div>
            </div>
            <% } %>

              <!-- 2. Área dos Coordenadores -->
              <div class="pdf-auth-heading pdf-auth-heading mt-25">
                Coordenação(ões)
              </div>
              <% if (p.assinaturasCoordenadoresRelatorio && p.assinaturasCoordenadoresRelatorio.length> 0) { %>
                <div class="pdf-auth-list">
                  <% p.assinaturasCoordenadoresRelatorio.forEach(ass=> { %>
                    <div class="assinatura-box pdf-auth-card">
                      <!-- Imagem Unicet -->
                      <div>
                        <img src="<%= logoSrc %>" alt="Unicet" class="pdf-auth-logo">
                      </div>
                      <!-- Nome e Código de Validação -->
                      <div class="pdf-auth-info">
                        <p class="pdf-auth-title">
                          <%= ass.nome %>
                        </p>
                        <p class="pdf-auth-meta">
                          Código de validação:<br>
                          <strong class="pdf-auth-hash">
                            <%= ass.Assinatura %>
                          </strong>
                        </p>
                      </div>
                      <!-- QR Code -->
                      <div>
                        <% const url_validacao=baseUrl + '/validar?codigo=' + ass.Assinatura; %>
                          <img
                            src="https://api.qrserver.com/v1/create-qr-code/?size=70x70&data=<%= encodeURIComponent(url_validacao) %>"
                            alt="QR Code de Validação" class="pdf-auth-qr">
                      </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                  <div class="sig-wrapper">
                    <div class="sig-container">
                      <div class="sig-line"></div>
                      <div class="sig-label">Coordenador(a) de Curso responsável</div>
                    </div>
                  </div>
                  <% } %>
      </div>

      <div class="section-title pdf-auth-section">XV - ANEXOS</div>
      <div class="form-block-container">
        <div class="form-value-block pdf-min-h-100">
          <%= safe(p.anexos) %>
        </div>
      </div>
    </div>
    <!--
    <script>
      window.onload = function () { window.print(); };
    </script>
-->
</body>

</html>