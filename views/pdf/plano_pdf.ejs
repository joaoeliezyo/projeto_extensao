<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Plano de Atividade de Extensão – UNI-CET</title>
  <link rel="stylesheet" href="/css/pdf.css">
</head>

<body>

  <% const p=projeto || {}; const formatDate=(d)=> {
    if (!d) return '___/___/______';
    try {
    const dt = new Date(d);
    const dd = String(dt.getDate()).padStart(2, '0');
    const mm = String(dt.getMonth() + 1).padStart(2, '0');
    const yyyy = dt.getFullYear();
    return dd + '/' + mm + '/' + yyyy;
    } catch(e) { return '___/___/______'; }
    };
    const formatBR = (valor) => {
    const num = Number(valor);
    if (Number.isNaN(num)) return valor ?? '0,00';
    return num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    const safe = (val) => val || '';
    const maskCpf = (cpf) => {
    if (!cpf) return '***.***.***-**';
    const clean = cpf.replace(/\D/g, '');
    if (clean.length !== 11) return cpf;
    return `***.${clean.substring(3, 6)}.${clean.substring(6, 9)}-**`;
    };
    const formatDataHora = (data) => {
    if (!data) return '';
    const dObj = new Date(data);
    if (Number.isNaN(dObj.getTime())) return data;
    return dObj.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });
    };
    const getPessoasStr = () => {
    if (!p.pessoas || p.pessoas.length === 0) return '';
    return p.pessoas.map(pe => pe.nome + ' (' + pe.papel + (pe.disciplina ? ' - ' + pe.disciplina : '') +
    (pe.cargahoraria ? ' - ' + pe.cargahoraria + 'h' : '') + ')').join(', ');
    };
    const getCursosStr = () => {
    if (!p.cursos || p.cursos.length === 0) return '___';
    return p.cursos.map(c => c.nome_curso).join(', ');
    };

    // Helpers para data de autenticação
    const dataRef = p.created_at ? new Date(p.created_at) : new Date();
    const authDia = String(dataRef.getDate()).padStart(2, '0');
    const meses =
    ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
    const authMes = meses[dataRef.getMonth()];
    const authAnoStr = String(dataRef.getFullYear()).slice(-2);
    %>

    <div class="page">
      <div class="header-container">
        <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
          <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
          <% } else { %>
            <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
            <% } %>
              <div class="header-text">
                <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
              </div>
      </div>

      <div class="doc-title-container">
        <div class="doc-title">PLANO DE ATIVIDADE DE EXTENSÃO</div>
      </div>

      <div class="form-row" style="margin-bottom: 15px;">
        <div class="form-label">TIPO DE EXTENSÃO:</div>
        <div class="form-line" style="font-weight: bold; font-size: 12px;">
          <%= safe(p.tipo_plano_nome) %>
        </div>
      </div>

      <div class="section-title">I- IDENTIFICAÇÃO</div>
      <div class="form-row">
        <div class="form-label">TÍTULO:</div>
        <div class="form-line">
          <%= safe(p.titulo) %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-label">LINHA PROGRAMÁTICA / PROGRAMA:</div>
        <div class="form-line">
          <%= (p.linhas && p.linhas.length> 0) ? p.linhas.map(l => l.nome).join(', ') : '___' %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-label">TIPO DE AÇÃO:</div>
        <div class="form-line">
          <%= (p.tiposAcao && p.tiposAcao.length> 0) ? p.tiposAcao.map(t => t.nome).join(', ') : '___' %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-label">INSTITUIÇÃO(ÕES) ENVOLVIDA(AS)</div>
      </div>
      <div class="form-line">
        <% if (p.instituicoes && p.instituicoes.length> 0) { %>
          <% p.instituicoes.forEach((inst)=> { %>

            <%= inst.tipo.toUpperCase() %>:
              <%= inst.nome %> (<%= inst.sigla %>)
                  <% }) %>
                    <% } %>
      </div>
      <!-- fim das instituições envolvidas-->

      <div class="form-row">
        <div class="form-label">COORDENADOR RESPONSÁVEL:</div>
      </div>
      <div class="form-line">
        <%= safe(p.coordenador_nome) %>
      </div>
      <!-- Coordenador Responsável-->

      <div class="form-row">
        <div class="form-label">PROFESSORES E TÉCNICOS ENVOLVIDOS:</div>
      </div>
      <div class="form-line">
        <%= getPessoasStr() %>
      </div>

      <!-- Professores e Técnicos Envolvidos-->
      <div class="form-row">
        <div class="form-label">CURSOS ENVOLVIDOS:</div>
      </div>
      <div class="form-line">
        <%= getCursosStr() %>
      </div>

      <!-- Cursos Envolvidos-->
      <div class="form-row">
        <div class="form-label" ">PERÍODO DE REALIZAÇÃO:</div>
      </div>
      <div class=" form-line">
          <%= formatDate(p.periodo_inicio) %> à <%= formatDate(p.periodo_fim) %>
        </div>

        <!-- Período de Realização-->
        <div class="form-row">
          <div class="form-label">LOCAL DE EXECUÇÃO:</div>
        </div>
        <div class="form-line">
          <% if (p.locais && p.locais.length> 0) { %>
            <% p.locais.forEach((loc, i)=> { %><%= loc.endereco %> - <%= loc.bairro %>, <%= loc.cidade %>
                    <%= i < p.locais.length - 1 ? '; ' : '' %>
                      <% }) %>
                        <% } %>
        </div>

        <!-- Local de Execução-->

        <div class="form-row">
          <div class="form-label">CARGA HORÁRIA TOTAL:</div>
        </div>
        <div class="form-line">
          <%= p.carga_horaria_total ? p.carga_horaria_total + ' horas' : '___' %>
        </div>
        <!-- Carga horária total-->

        <div class="form-row">
          <div class="form-label">PÚBLICO-ALVO:</div>
        </div>
        <div class="form-line">
          <%= safe(p.publico_alvo_nome) %>
        </div>

        <!-- Público-alvo-->
        <div class="section-title">II- OBJETIVO(S)</div>
        <div class="form-block-container">
          <div class="form-value-block" style="white-space: normal;">
            <%- safe(p.objetivo) %>
          </div>
        </div>

        <div class="section-title">III- METODOLOGIA</div>
        <div class="form-block-container">
          <div class="form-value-block" style="white-space: normal;">
            <%- safe(p.metodologia) %>
          </div>
        </div>

        <div class="section-title">IV- CRONOGRAMA DE ATIVIDADES E AÇÕES</div>
        <table>
          <thead>
            <tr>
              <th style="width: 6%;">Nº</th>
              <th style="width: 54%;">Etapa</th>
              <th style="width: 14%;">Data</th>
              <th style="width: 11%;">Hora</th>
              <th style="width: 15%;">Local</th>
            </tr>
          </thead>
          <tbody>
            <% if (p.cronograma && p.cronograma.length> 0) { %>
              <% p.cronograma.forEach((c, i)=> { %>
                <tr>
                  <td class="text-center">
                    <%= c.numero || (i + 1) %>
                  </td>
                  <td>
                    <%= c.etapa || '' %>
                  </td>
                  <td class="text-center">
                    <%= formatDate(c.data) %>
                  </td>
                  <td class="text-center">
                    <%= c.hora || '' %>
                  </td>
                  <td>
                    <%= c.local || '' %>
                  </td>
                </tr>
                <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center">Nenhum cronograma cadastrado.</td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
        <!-- fim das custas-->
        <div class="section-title">V- CUSTOS DO PROJETO</div>
        <table>
          <thead>
            <tr>
              <th style="width: 8%;">Nº</th>
              <th style="width: 35%;">Descrição da Despesa</th>
              <th style="width: 10%;">Quantidade</th>
              <th style="width: 15%;">Valor Unitário (R$)</th>
              <th style="width: 15%;">Valor Total (R$)</th>
              <th style="width: 17%;">Justificativa</th>
            </tr>
          </thead>
          <tbody>
            <% let totalGeral=0; %>
              <% if (p.custos && p.custos.length> 0) { %>
                <% p.custos.forEach((cu, idx)=> { %>
                  <% const qtd=Number(cu.quantitativo || 0); const unit=Number(cu.valor_unitario || 0); const vt=qtd *
                    unit; totalGeral +=vt; %>
                    <tr>
                      <td class="text-center">
                        <%= idx + 1 %>
                      </td>
                      <td>
                        <%= cu.descricao || '' %>
                      </td>
                      <td class="text-center">
                        <%= cu.quantitativo || '' %>
                      </td>
                      <td class="text-right">
                        <%= formatBR(unit) %>
                      </td>
                      <td class="text-right">
                        <%= formatBR(vt) %>
                      </td>
                      <td>
                        <%= cu.justificativa || '' %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
                        <tr>
                          <td colspan="4" class="text-right" style="font-weight: bold; padding-right: 8px;">Total
                            Geral
                          </td>
                          <td class="text-right" style="font-weight: bold;">
                            <%= formatBR(totalGeral) %>
                          </td>
                          <td></td>
                        </tr>
          </tbody>
        </table>

        <!--
      <div class="subsection-title" style="margin-top: 15px;">Fonte de Recursos:</div>
      <div class="form-line" style="min-height: 24px; margin-bottom: 20px;"></div>
      -->
        <div class="section-title">VI- RESULTADOS ESPERADOS</div>
        <div class="form-block-container">
          <div class="form-value-block" style="white-space: normal;">
            <%- safe(p.resultados_esperados) %>
          </div>
        </div>
        <div class=" section-title">VII- AVALIAÇÃO</div>
          <div class="form-block-container">
            <div class="form-value-block" style="white-space: normal;">
            <%- safe(p.avaliacao_descricao) %>
          </div>
        </div>
      </div> <!-- fim do bloco do formulario-->
    </div> <!-- fim da pagina-->

    <div class=" page">
              <div class="header-container">
                <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
                  <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
                  <% } else { %>
                    <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
                    <% } %>
                      <div class="header-text">
                        <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                        <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
                      </div>
              </div>
              <div class="section-title" style="text-align: center;">
                VIII- RESULTADOS ALCANÇADOS (INDICADORES QUALITATIVOS E QUANTITATIVOS)
              </div>
              <div class="doc-title-container" style="margin: 5px 0 15px 0;">
                <div class="doc-title" style="font-size: 11px;">QUESTIONÁRIO DE AVALIAÇÃO DE IMPACTO DA AÇÃO
                  EXTENSIONISTA
                </div>
              </div>

              <div style="margin: 10px 0;">
                <div class="form-row">
                  <div class="form-label">Nome da Ação Extensionista:</div>
                  <div class="form-line"></div>
                </div>
                <div class="form-row">
                  <div class="form-label">Instituição:</div>
                  <div class="form-line"></div>
                </div>
                <div class="form-row">
                  <div class="form-label">Data da realização:</div>
                  <div class="form-line"></div>
                </div>
                <div class="form-row">
                  <div class="form-label">Tipo de ação selecionada:</div>
                  <div class="form-line" style="font-weight: bold;"></div>
                </div>
                <div class="form-row">
                  <div class="form-label">Local de realização:</div>
                  <div class="form-line"></div>
                </div>
              </div>

              <div class="section-title" style="margin-top: 20px;">1. Perfil dos participantes</div>
              <div class="form-row">
                <div class="form-label">1.1. Faixa etária selecionada:</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">1.2. Escolaridade selecionada:</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">1.3. Reside na comunidade/localidade atendida?</div>
                <div class="form-line"></div>
              </div>

              <div class="section-title" style="margin-top: 20px;">2. Avaliação da Ação Extensionista</div>
              <div class="form-row">
                <div class="form-label">2.1. Avaliação dos conteúdos/aprendizados oferecidos:</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">2.2. A ação atendeu às suas expectativas?</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">2.3. Os facilitadores/professores/orientadores foram claros e acessíveis?
                </div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">2.4. Houve espaço para escuta e participação da comunidade?</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">2.5. A estrutura e organização da ação foram adequadas?</div>
                <div class="form-line"></div>
              </div>

              <div class="section-title">3. Percepção de Impacto na Sua Vida / Comunidade</div>
              <div class="form-row">
                <div class="form-label">3.1. Após participar da ação, sente-se mais capacitado(a) ou informado(a)?
                </div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">3.2. A ação contribuiu para melhorar algum aspectoda sua vida?</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label" style="padding-left: 15px;">Descrição do aspecto melhorado:</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">3.3. Pretende aplicar os conhecimentos adquiridos na sua rotina?</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label" style="padding-left: 15px;">Justificativa / Motivo:</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">3.4. Você recomendaria essa ação para outras pessoas?</div>
                <div class="form-line"></div>
              </div>

              <div class="section-title">4. Sugestões e Comentários (Avaliação Qualitativa)</div>
              <div class="form-row">
                <div class="form-label">4.1. O que você mais gostou na ação?</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">4.2. O que poderia ser melhorado?</div>
                <div class="form-line"></div>
              </div>
              <div class="form-row">
                <div class="form-label">4.3. Deseja sugerir outras ações ou temas para futuras atividades?</div>
                <div class="form-line"></div>
              </div>

              <div class="section-title">5. Consentimento</div>
              <div class="form-row">
                <div class="form-label" style="font-weight: normal;">Autoriza o uso das informações garantindo o
                  anonimato?
                </div>
                <div class="form-line"></div>
              </div>
            </div>

            <div class="page">
              <div class="header-container">
                <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
                  <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
                  <% } else { %>
                    <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
                    <% } %>
                      <div class="header-text">
                        <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                        <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
                      </div>
              </div>

              <div class="section-title">IX - REFERÊNCIAS</div>
              <div class="form-line mb-3">
                <%- safe(p.referencias) %>
              </div>

              <div class="section-title pdf-auth-section">X- AUTENTICAÇÃO</div>
              <div class="date-row">
                Teresina, <span class="pdf-date-blank-35">
                  <%= authDia %>
                </span> de <span class="pdf-date-blank-90">
                  <%= authMes %>
                </span> de 20<span class="pdf-date-blank-30">
                  <%= authAnoStr %>
                </span>.
              </div>

              <div class="pdf-auth-section">
                <!-- 1. Área dos Professores -->
                <div class="pdf-auth-heading">
                  Professor(es)
                </div>
                <% if (p.assinaturasProfessoresPlano && p.assinaturasProfessoresPlano.length > 0) { %>
                  <div class="pdf-auth-list">
                    <% p.assinaturasProfessoresPlano.forEach(ass => { %>
                      <div class="assinatura-box pdf-auth-card">
                        <!-- Imagem Unicet -->
                        <div>
                          <img src="<%= logoSrc %>" alt="Unicet" class="pdf-auth-logo">
                        </div>
                        <!-- Nome e Código de Validação -->
                        <div class="pdf-auth-info">
                          <p class="pdf-auth-title">
                            <%= ass.nome %>
                          </p>
                          <p class="pdf-auth-meta">
                            Código de validação:<br>
                            <strong class="pdf-auth-hash"><%= ass.Assinatura %></strong>
                          </p>
                        </div>
                        <!-- QR Code -->
                        <div>
                          <% const url_validacao = baseUrl + '/validar?codigo=' + ass.Assinatura; %>
                          <img src="https://api.qrserver.com/v1/create-qr-code/?size=70x70&data=<%= encodeURIComponent(url_validacao) %>"
                               alt="QR Code de Validação" class="pdf-auth-qr">
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="sig-wrapper pdf-sig-wrapper">
                    <div class="sig-container">
                      <div class="sig-line"></div>
                      <div class="sig-label">Docente responsável</div>
                    </div>
                  </div>
                <% } %>

                <!-- 2. Área dos Coordenadores -->
                <div class="pdf-auth-heading mt-25">
                  Coordenação(ões)
                </div>
                <% if (p.assinaturasCoordenadoresPlano && p.assinaturasCoordenadoresPlano.length > 0) { %>
                  <div class="pdf-auth-list">
                    <% p.assinaturasCoordenadoresPlano.forEach(ass => { %>
                      <div class="assinatura-box pdf-auth-card">
                        <!-- Imagem Unicet -->
                        <div>
                          <img src="<%= logoSrc %>" alt="Unicet" class="pdf-auth-logo">
                        </div>
                        <!-- Nome e Código de Validação -->
                        <div class="pdf-auth-info">
                          <p class="pdf-auth-title">
                            <%= ass.nome %>
                          </p>
                          <p class="pdf-auth-meta">
                            Código de validação:<br>
                            <strong class="pdf-auth-hash"><%= ass.Assinatura %></strong>
                          </p>
                        </div>
                        <!-- QR Code -->
                        <div>
                          <% const url_validacao = baseUrl + '/validar?codigo=' + ass.Assinatura; %>
                          <img src="https://api.qrserver.com/v1/create-qr-code/?size=70x70&data=<%= encodeURIComponent(url_validacao) %>"
                               alt="QR Code de Validação" class="pdf-auth-qr">
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="sig-wrapper">
                    <div class="sig-container">
                      <div class="sig-line"></div>
                      <div class="sig-label">Coordenador(a) de Curso responsável</div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
          <!--
          <div class="page">
            <div class="header-container">
              <% if (typeof logoSrc !=='undefined' && logoSrc) { %>
                <img src="<%= logoSrc %>" alt="UNI-CET Centro Universitário" class="logo-img">
                <% } else { %>
                  <img src="/imagens/logo-unicet.png" alt="UNI-CET Centro Universitário" class="logo-img">
                  <% } %>
                    <div class="header-text">
                      <h1>CENTRO DE EDUCAÇÃO TECNOLÓGICA DE TERESINA – CET</h1>
                      <h2>CENTRO UNIVERSITÁRIO TECNOLÓGICO DE TERESINA – UNI-CET</h2>
                    </div>
            </div>

