<%- include('../cabecalho', { titulo: 'Controle de Assinatura do Projeto' }) %>

<% 
const lista = Array.isArray(dados) ? dados : [];
const idPessoaSessao = (typeof id_pessoa !== 'undefined') ? Number(id_pessoa) : null;
const cleanUserCpf = (typeof userCpf !== 'undefined') ? userCpf.replace(/\D/g, '') : '';

const formatDataHora = (data) => {
    if (!data) return '';
    const dObj = new Date(data);
    if (Number.isNaN(dObj.getTime())) return data;
    return dObj.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });
};

// Determinar papéis do usuário logado
const isProf = (typeof projeto !== 'undefined' && projeto.professoresCadastrados) ? 
    projeto.professoresCadastrados.some(p => p.CPF && p.CPF.replace(/\D/g, '') === cleanUserCpf) : false;

const isCoord = (typeof projeto !== 'undefined' && projeto.coordenadoresCursos) ? 
    projeto.coordenadoresCursos.some(c => Number(c.coordenador_id) === Number(idPessoaSessao)) : false;

const totalProfs = (typeof projeto !== 'undefined' && projeto.professoresCadastrados) ? projeto.professoresCadastrados.length : 0;
const totalCoords = (typeof projeto !== 'undefined' && projeto.coordenadoresCursos) ? projeto.coordenadoresCursos.length : 0;

// PLANO (tipo = 1 ou NULL)
const totalProfsAssinadosPlano = (typeof projeto !== 'undefined' && projeto.assinaturasProfessoresPlano) ? projeto.assinaturasProfessoresPlano.length : 0;
const allProfsSignedPlano = totalProfsAssinadosPlano >= totalProfs;

const totalCoordsAssinadosPlano = (typeof projeto !== 'undefined' && projeto.assinaturasCoordenadoresPlano) ? projeto.assinaturasCoordenadoresPlano.length : 0;
const allCoordsSignedPlano = totalCoordsAssinadosPlano >= totalCoords;
const allPlanSigned = allProfsSignedPlano && allCoordsSignedPlano;

const alreadySignedAsProfPlano = (typeof projeto !== 'undefined' && projeto.assinaturasProfessoresPlano) ? 
    projeto.assinaturasProfessoresPlano.some(ass => ass.cpf && ass.cpf.replace(/\D/g, '') === cleanUserCpf) : false;

const alreadySignedAsCoordPlano = (typeof projeto !== 'undefined' && projeto.assinaturasCoordenadoresPlano) ? 
    projeto.assinaturasCoordenadoresPlano.some(ass => Number(ass.id_pessoa) === Number(idPessoaSessao)) : false;

const hasCoordinatorSignedPlano = totalCoordsAssinadosPlano > 0;

// RELATÓRIO (tipo = 2)
const totalProfsAssinadosRelatorio = (typeof projeto !== 'undefined' && projeto.assinaturasProfessoresRelatorio) ? projeto.assinaturasProfessoresRelatorio.length : 0;
const allProfsSignedRelatorio = totalProfsAssinadosRelatorio >= totalProfs;

const totalCoordsAssinadosRelatorio = (typeof projeto !== 'undefined' && projeto.assinaturasCoordenadoresRelatorio) ? projeto.assinaturasCoordenadoresRelatorio.length : 0;
const allCoordsSignedRelatorio = totalCoordsAssinadosRelatorio >= totalCoords;

const alreadySignedAsProfRelatorio = (typeof projeto !== 'undefined' && projeto.assinaturasProfessoresRelatorio) ? 
    projeto.assinaturasProfessoresRelatorio.some(ass => ass.cpf && ass.cpf.replace(/\D/g, '') === cleanUserCpf) : false;

const alreadySignedAsCoordRelatorio = (typeof projeto !== 'undefined' && projeto.assinaturasCoordenadoresRelatorio) ? 
    projeto.assinaturasCoordenadoresRelatorio.some(ass => Number(ass.id_pessoa) === Number(idPessoaSessao)) : false;

const hasCoordinatorSignedRelatorio = totalCoordsAssinadosRelatorio > 0;

// Listas filtradas para renderizar nas tabelas
const listaPlano = lista.filter(d => d.tipo_assinatura !== 2);
const listaRelatorio = lista.filter(d => d.tipo_assinatura === 2);

const isProjectConcluido = (typeof projeto !== 'undefined' && projeto.status === 'concluido');
const canSignRelatorioPhase = isProjectConcluido && allPlanSigned;
%>

<main id="conteudo-principal-form" class="container my-5">
    <!-- Bloco principal de Feedback -->
    <% if (locals.flash) { %>
        <div class="alert alert-<%= locals.flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show shadow-sm mb-4" role="alert" style="border-radius:10px;">
            <i class="bi <%= locals.flash.type === 'error' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill' %> me-2"></i>
            <%= locals.flash.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <section id="secao-cadastro-projeto" class="card shadow border-0 p-4 p-md-5" style="border-radius:16px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <span class="text-uppercase tracking-wider text-muted small fw-bold">PROJETO DE EXTENSÃO</span>
                <h1 class="fs-3 fw-bold mb-1 text-primary"><%= (typeof projeto !== 'undefined') ? projeto.titulo : 'Assinatura' %></h1>
                <p class="text-muted mb-0 small">Código do Projeto: <strong><%= id_projeto %></strong></p>
                <p class="text-muted mb-0 small">Status Atual: 
                    <span class="badge bg-info text-dark" style="font-size:0.75rem;">
                        <%= (typeof projeto !== 'undefined') ? projeto.status.toUpperCase() : 'DESCONHECIDO' %>
                    </span>
                </p>
            </div>
            <div class="mt-2 mt-md-0">
                <a href="/projeto_extensao" class="btn btn-outline-secondary btn-sm" style="border-radius:8px;">
                    <i class="bi bi-arrow-left me-1"></i> Voltar aos Projetos
                </a>
            </div>
        </div>

        <!-- ==================== SEÇÃO 1: PLANO DE TRABALHO ==================== -->
        <div class="border border-success-subtle p-3 p-md-4 mb-5 rounded-4 bg-light bg-opacity-50">
            <h3 class="fs-5 fw-bold text-success mb-3 pb-2 border-bottom">
                <i class="bi bi-file-earmark-text-fill me-2"></i>Etapa 1: Assinaturas do Plano de Trabalho
            </h3>

            <!-- Painel de Status de Assinatura do Plano -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-white p-3 shadow-sm" style="border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark small">
                                <i class="bi bi-people-fill me-1 text-success"></i> Professores (Plano)
                            </h6>
                            <span class="badge <%= allProfsSignedPlano ? 'bg-success' : 'bg-warning text-dark' %>" style="border-radius:20px;">
                                <%= totalProfsAssinadosPlano %> / <%= totalProfs %>
                            </span>
                        </div>
                        <% if (typeof projeto !== 'undefined' && projeto.professoresCadastrados && projeto.professoresCadastrados.length > 0) { %>
                            <ul class="list-group list-group-flush mt-2">
                                <% projeto.professoresCadastrados.forEach(p => { 
                                    const pCpfClean = p.CPF ? p.CPF.replace(/\D/g, '') : '';
                                    const isSigned = projeto.assinaturasProfessoresPlano.some(ass => ass.cpf && ass.cpf.replace(/\D/g, '') === pCpfClean);
                                %>
                                    <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center border-0 border-bottom">
                                        <div class="small">
                                            <div class="fw-bold"><%= p.NOMEPROFESSOR %></div>
                                            <div class="text-muted font-monospace" style="font-size:0.75rem;">CPF: <%= p.CPF %></div>
                                        </div>
                                        <span class="badge <%= isSigned ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-muted' %>" style="border-radius:10px; font-size:0.75rem;">
                                            <i class="bi <%= isSigned ? 'bi-check-circle-fill' : 'bi-clock' %> me-1"></i>
                                            <%= isSigned ? 'Assinado' : 'Pendente' %>
                                        </span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted small mt-2">Nenhum professor cadastrado para este projeto.</p>
                        <% } %>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-white p-3 shadow-sm" style="border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark small">
                                <i class="bi bi-shield-check me-1 text-success"></i> Coordenadores (Plano)
                            </h6>
                            <span class="badge <%= allCoordsSignedPlano ? 'bg-success' : 'bg-warning text-dark' %>" style="border-radius:20px;">
                                <%= totalCoordsAssinadosPlano %> / <%= totalCoords %>
                            </span>
                        </div>
                        <% if (typeof projeto !== 'undefined' && projeto.coordenadoresCursos && projeto.coordenadoresCursos.length > 0) { %>
                            <ul class="list-group list-group-flush mt-2">
                                <% projeto.coordenadoresCursos.forEach(c => { 
                                    const isSigned = projeto.assinaturasCoordenadoresPlano.some(ass => Number(ass.id_pessoa) === Number(c.coordenador_id));
                                %>
                                    <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center border-0 border-bottom">
                                        <div class="small">
                                            <div class="fw-bold"><%= c.nome %></div>
                                            <div class="text-muted font-monospace" style="font-size:0.75rem;">ID Coordenador: <%= c.coordenador_id %></div>
                                        </div>
                                        <span class="badge <%= isSigned ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-muted' %>" style="border-radius:10px; font-size:0.75rem;">
                                            <i class="bi <%= isSigned ? 'bi-check-circle-fill' : 'bi-clock' %> me-1"></i>
                                            <%= isSigned ? 'Assinado' : 'Pendente' %>
                                        </span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted small mt-2">Nenhum coordenador encontrado.</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Card de Ação do Plano -->
            <div class="card border border-success-subtle p-3 mb-4 bg-white" style="border-radius:12px;">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="mb-1">
                            <% if (isProf) { %>
                                <span class="badge bg-primary"><i class="bi bi-person-fill"></i> Professor</span>
                            <% } %>
                            <% if (isCoord) { %>
                                <span class="badge bg-info text-dark ms-1"><i class="bi bi-shield-check"></i> Coordenador</span>
                            <% } %>
                        </div>
                        <p class="mb-0 text-muted small">
                            <% if (isProf && !alreadySignedAsProfPlano) { %>
                                Você pode assinar o Plano como Professor.
                            <% } else if (isProf && alreadySignedAsProfPlano && !isCoord) { %>
                                Você já assinou o Plano como Professor.
                            <% } else if (isCoord && !['aprovado', 'em_execucao', 'concluido'].includes(projeto.status)) { %>
                                <strong>Atenção:</strong> Você é coordenador, mas a assinatura do Plano está bloqueada até que o projeto seja Aprovado.
                            <% } else if (isCoord && !allProfsSignedPlano) { %>
                                Assinatura de Coordenador bloqueada até que todos os professores cadastrados assinem o Plano.
                            <% } else if (isCoord && allProfsSignedPlano && !alreadySignedAsCoordPlano) { %>
                                Todos os professores assinaram e o projeto está Aprovado. Você já pode assinar o Plano como Coordenador!
                            <% } else if (isCoord && alreadySignedAsCoordPlano) { %>
                                Você já assinou o Plano como Coordenador.
                            <% } else if (!isProf && !isCoord) { %>
                                Sem permissão para assinar.
                            <% } %>
                        </p>
                    </div>
                    <div>
                        <% 
                        let canSubmitPlano = false;
                        let submitPlanoText = 'Assinar Plano';
                        if (isProf && !alreadySignedAsProfPlano) {
                            canSubmitPlano = true;
                            submitPlanoText = 'Assinar como Professor';
                        } else if (isCoord && allProfsSignedPlano && !alreadySignedAsCoordPlano && ['aprovado', 'em_execucao', 'concluido'].includes(projeto.status)) {
                            canSubmitPlano = true;
                            submitPlanoText = 'Assinar como Coordenador';
                        }
                        %>
                        <% if (canSubmitPlano) { %>
                            <form method="POST" action="/projeto_assinatura/<%= id_projeto %>/assinar">
                                <input type="hidden" name="id_projeto" value="<%= id_projeto %>">
                                <input type="hidden" name="tipo_assinatura" value="1">
                                <button type="submit" class="btn btn-success px-4 btn-sm fw-bold">
                                    <i class="bi bi-pencil-fill me-1"></i> <%= submitPlanoText %>
                                </button>
                            </form>
                        <% } else { %>
                            <button class="btn btn-secondary px-4 btn-sm fw-bold" disabled>
                                <i class="bi bi-lock-fill me-1"></i> Assinar Plano
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Tabela de Assinaturas do Plano -->
            <div class="table-responsive">
                <table class="table table-hover align-middle border" style="border-radius: 8px; overflow: hidden; font-size:0.875rem;">
                    <thead class="table-success">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Assinante</th>
                            <th>CPF</th>
                            <th>Código de Validação</th>
                            <th>Data/Hora</th>
                            <th>Função</th>
                            <th class="text-end pe-3">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (listaPlano.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">Nenhuma assinatura do Plano registrada até o momento.</td>
                            </tr>
                        <% } else { %>
                            <% listaPlano.forEach((d) => { 
                                const cleanAssCpf = d.cpf ? d.cpf.replace(/\D/g, '') : '';
                                const isProfSig = (typeof projeto !== 'undefined' && projeto.professoresCadastrados) ? 
                                    projeto.professoresCadastrados.some(p => p.CPF && p.CPF.replace(/\D/g, '') === cleanAssCpf) : false;
                                
                                const isCoordSig = (typeof projeto !== 'undefined' && projeto.coordenadoresCursos) ? 
                                    projeto.coordenadoresCursos.some(c => Number(c.coordenador_id) === Number(d.id_pessoa)) : false;

                                let papel = 'Assinante';
                                if (d.ordem === 1 || (isProfSig && d.ordem !== 2)) {
                                    papel = 'Professor(a)';
                                } else if (d.ordem === 2 || isCoordSig) {
                                    papel = 'Coordenador(a)';
                                }

                                const isOwnSignature = (idPessoaSessao !== null && Number(d.id_pessoa) === idPessoaSessao);
                                let canDelete = false;
                                let blockReason = '';

                                if (isOwnSignature) {
                                    if (papel === 'Professor(a)') {
                                        if (hasCoordinatorSignedPlano) {
                                            canDelete = false;
                                            blockReason = 'Bloqueado: Um coordenador já assinou o plano.';
                                        } else {
                                            canDelete = true;
                                        }
                                    } else {
                                        canDelete = true;
                                    }
                                }
                            %>
                                <tr>
                                    <td class="ps-3 fw-bold text-muted"><%= d.id %></td>
                                    <td class="fw-bold" style="text-transform: uppercase;"><%= d.nome %></td>
                                    <td class="font-monospace">
                                        <% 
                                        const cleanCPF = d.cpf ? d.cpf.replace(/\D/g, '') : '';
                                        let maskedCPF = '***.***.***-**';
                                        if (cleanCPF.length === 11) {
                                            maskedCPF = '***.' + cleanCPF.substring(3, 6) + '.' + cleanCPF.substring(6, 9) + '-**';
                                        }
                                        %>
                                        <%= maskedCPF %>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-success border font-monospace py-1 px-2">
                                            <%= d.Assinatura %>
                                        </span>
                                    </td>
                                    <td class="small text-muted"><%= formatDataHora(d.data_hora) %></td>
                                    <td>
                                        <span class="badge <%= papel === 'Coordenador(a)' ? 'bg-info-subtle text-info-emphasis' : 'bg-primary-subtle text-primary-emphasis' %>">
                                            <%= papel %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <% if (isOwnSignature) { %>
                                            <% if (canDelete) { %>
                                                <form method="POST" action="/projeto_assinatura/<%= d.id %>/delete" style="display:inline" onsubmit="return confirm('Deseja realmente remover sua assinatura desta etapa?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Remover Assinatura" style="font-size:0.75rem;">
                                                        <i class="bi bi-trash-fill"></i> Excluir
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-muted" title="<%= blockReason %>" style="font-size:0.7rem;">
                                                    <i class="bi bi-lock-fill"></i> Bloqueado
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>


        <!-- ==================== SEÇÃO 2: RELATÓRIO FINAL ==================== -->
        <div class="border border-primary-subtle p-3 p-md-4 rounded-4 bg-light bg-opacity-50">
            <h3 class="fs-5 fw-bold text-primary mb-3 pb-2 border-bottom">
                <i class="bi bi-journal-check me-2"></i>Etapa 2: Assinaturas do Relatório Final
            </h3>

            <!-- Painel de Status de Assinatura do Relatório -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-white p-3 shadow-sm" style="border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark small">
                                <i class="bi bi-people-fill me-1 text-primary"></i> Professores (Relatório)
                            </h6>
                            <span class="badge <%= allProfsSignedRelatorio ? 'bg-primary' : 'bg-warning text-dark' %>" style="border-radius:20px;">
                                <%= totalProfsAssinadosRelatorio %> / <%= totalProfs %>
                            </span>
                        </div>
                        <% if (typeof projeto !== 'undefined' && projeto.professoresCadastrados && projeto.professoresCadastrados.length > 0) { %>
                            <ul class="list-group list-group-flush mt-2">
                                <% projeto.professoresCadastrados.forEach(p => { 
                                    const pCpfClean = p.CPF ? p.CPF.replace(/\D/g, '') : '';
                                    const isSigned = projeto.assinaturasProfessoresRelatorio.some(ass => ass.cpf && ass.cpf.replace(/\D/g, '') === pCpfClean);
                                %>
                                    <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center border-0 border-bottom">
                                        <div class="small">
                                            <div class="fw-bold"><%= p.NOMEPROFESSOR %></div>
                                            <div class="text-muted font-monospace" style="font-size:0.75rem;">CPF: <%= p.CPF %></div>
                                        </div>
                                        <span class="badge <%= isSigned ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-muted' %>" style="border-radius:10px; font-size:0.75rem;">
                                            <i class="bi <%= isSigned ? 'bi-check-circle-fill' : 'bi-clock' %> me-1"></i>
                                            <%= isSigned ? 'Assinado' : 'Pendente' %>
                                        </span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted small mt-2">Nenhum professor cadastrado para este projeto.</p>
                        <% } %>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-white p-3 shadow-sm" style="border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark small">
                                <i class="bi bi-shield-check me-1 text-primary"></i> Coordenadores (Relatório)
                            </h6>
                            <span class="badge <%= allCoordsSignedRelatorio ? 'bg-primary' : 'bg-warning text-dark' %>" style="border-radius:20px;">
                                <%= totalCoordsAssinadosRelatorio %> / <%= totalCoords %>
                            </span>
                        </div>
                        <% if (typeof projeto !== 'undefined' && projeto.coordenadoresCursos && projeto.coordenadoresCursos.length > 0) { %>
                            <ul class="list-group list-group-flush mt-2">
                                <% projeto.coordenadoresCursos.forEach(c => { 
                                    const isSigned = projeto.assinaturasCoordenadoresRelatorio.some(ass => Number(ass.id_pessoa) === Number(c.coordenador_id));
                                %>
                                    <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center border-0 border-bottom">
                                        <div class="small">
                                            <div class="fw-bold"><%= c.nome %></div>
                                            <div class="text-muted font-monospace" style="font-size:0.75rem;">ID Coordenador: <%= c.coordenador_id %></div>
                                        </div>
                                        <span class="badge <%= isSigned ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-muted' %>" style="border-radius:10px; font-size:0.75rem;">
                                            <i class="bi <%= isSigned ? 'bi-check-circle-fill' : 'bi-clock' %> me-1"></i>
                                            <%= isSigned ? 'Assinado' : 'Pendente' %>
                                        </span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted small mt-2">Nenhum coordenador encontrado.</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Card de Ação do Relatório -->
            <div class="card border border-primary-subtle p-3 mb-4 bg-white" style="border-radius:12px;">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="mb-1">
                            <% if (isProf) { %>
                                <span class="badge bg-primary"><i class="bi bi-person-fill"></i> Professor</span>
                            <% } %>
                            <% if (isCoord) { %>
                                <span class="badge bg-info text-dark ms-1"><i class="bi bi-shield-check"></i> Coordenador</span>
                            <% } %>
                        </div>
                        
                        <% if (!canSignRelatorioPhase) { %>
                            <p class="mb-0 text-danger small">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                <strong>Bloqueado:</strong>
                                <% if (!isProjectConcluido && !allPlanSigned) { %>
                                    O status do projeto deve ser 'Concluído' pela coordenação e todas as assinaturas do Plano de Trabalho devem estar preenchidas.
                                <% } else if (!isProjectConcluido) { %>
                                    O status do projeto deve ser alterado para 'Concluído' pela coordenação antes de permitir as assinaturas do relatório.
                                <% } else if (!allPlanSigned) { %>
                                    Todas as assinaturas do Plano de Trabalho devem ser realizadas primeiro.
                                <% } %>
                            </p>
                        <% } else { %>
                            <p class="mb-0 text-muted small">
                                <% if (isProf && !alreadySignedAsProfRelatorio) { %>
                                    Você pode assinar o Relatório Final como Professor.
                                <% } else if (isProf && alreadySignedAsProfRelatorio && !isCoord) { %>
                                    Você já assinou o Relatório Final como Professor.
                                <% } else if (isCoord && !allProfsSignedRelatorio) { %>
                                    Assinatura de Coordenador bloqueada até que todos os professores cadastrados assinem o Relatório.
                                <% } else if (isCoord && allProfsSignedRelatorio && !alreadySignedAsCoordRelatorio) { %>
                                    Todos os professores assinaram. Você já pode assinar o Relatório como Coordenador!
                                <% } else if (isCoord && alreadySignedAsCoordRelatorio) { %>
                                    Você já assinou o Relatório como Coordenador.
                                <% } else if (!isProf && !isCoord) { %>
                                    Sem permissão para assinar.
                                <% } %>
                            </p>
                        <% } %>
                    </div>
                    <div>
                        <% 
                        let canSubmitRelatorio = false;
                        let submitRelatorioText = 'Assinar Relatório';
                        if (canSignRelatorioPhase) {
                            if (isProf && !alreadySignedAsProfRelatorio) {
                                canSubmitRelatorio = true;
                                submitRelatorioText = 'Assinar como Professor';
                            } else if (isCoord && allProfsSignedRelatorio && !alreadySignedAsCoordRelatorio) {
                                canSubmitRelatorio = true;
                                submitRelatorioText = 'Assinar como Coordenador';
                            }
                        }
                        %>
                        <% if (canSubmitRelatorio) { %>
                            <form method="POST" action="/projeto_assinatura/<%= id_projeto %>/assinar">
                                <input type="hidden" name="id_projeto" value="<%= id_projeto %>">
                                <input type="hidden" name="tipo_assinatura" value="2">
                                <button type="submit" class="btn btn-primary px-4 btn-sm fw-bold">
                                    <i class="bi bi-pencil-fill me-1"></i> <%= submitRelatorioText %>
                                </button>
                            </form>
                        <% } else { %>
                            <button class="btn btn-secondary px-4 btn-sm fw-bold" disabled>
                                <i class="bi bi-lock-fill me-1"></i> Assinar Relatório
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Tabela de Assinaturas do Relatório -->
            <div class="table-responsive">
                <table class="table table-hover align-middle border" style="border-radius: 8px; overflow: hidden; font-size:0.875rem;">
                    <thead class="table-primary">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Assinante</th>
                            <th>CPF</th>
                            <th>Código de Validação</th>
                            <th>Data/Hora</th>
                            <th>Função</th>
                            <th class="text-end pe-3">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (listaRelatorio.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">Nenhuma assinatura do Relatório registrada até o momento.</td>
                            </tr>
                        <% } else { %>
                            <% listaRelatorio.forEach((d) => { 
                                const cleanAssCpf = d.cpf ? d.cpf.replace(/\D/g, '') : '';
                                const isProfSig = (typeof projeto !== 'undefined' && projeto.professoresCadastrados) ? 
                                    projeto.professoresCadastrados.some(p => p.CPF && p.CPF.replace(/\D/g, '') === cleanAssCpf) : false;
                                
                                const isCoordSig = (typeof projeto !== 'undefined' && projeto.coordenadoresCursos) ? 
                                    projeto.coordenadoresCursos.some(c => Number(c.coordenador_id) === Number(d.id_pessoa)) : false;

                                let papel = 'Assinante';
                                if (d.ordem === 1 || (isProfSig && d.ordem !== 2)) {
                                    papel = 'Professor(a)';
                                } else if (d.ordem === 2 || isCoordSig) {
                                    papel = 'Coordenador(a)';
                                }

                                const isOwnSignature = (idPessoaSessao !== null && Number(d.id_pessoa) === idPessoaSessao);
                                let canDelete = false;
                                let blockReason = '';

                                if (isOwnSignature) {
                                    if (papel === 'Professor(a)') {
                                        if (hasCoordinatorSignedRelatorio) {
                                            canDelete = false;
                                            blockReason = 'Bloqueado: Um coordenador já assinou o relatório.';
                                        } else {
                                            canDelete = true;
                                        }
                                    } else {
                                        canDelete = true;
                                    }
                                }
                            %>
                                <tr>
                                    <td class="ps-3 fw-bold text-muted"><%= d.id %></td>
                                    <td class="fw-bold" style="text-transform: uppercase;"><%= d.nome %></td>
                                    <td class="font-monospace">
                                        <% 
                                        const cleanCPF = d.cpf ? d.cpf.replace(/\D/g, '') : '';
                                        let maskedCPF = '***.***.***-**';
                                        if (cleanCPF.length === 11) {
                                            maskedCPF = '***.' + cleanCPF.substring(3, 6) + '.' + cleanCPF.substring(6, 9) + '-**';
                                        }
                                        %>
                                        <%= maskedCPF %>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border font-monospace py-1 px-2">
                                            <%= d.Assinatura %>
                                        </span>
                                    </td>
                                    <td class="small text-muted"><%= formatDataHora(d.data_hora) %></td>
                                    <td>
                                        <span class="badge <%= papel === 'Coordenador(a)' ? 'bg-info-subtle text-info-emphasis' : 'bg-primary-subtle text-primary-emphasis' %>">
                                            <%= papel %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <% if (isOwnSignature) { %>
                                            <% if (canDelete) { %>
                                                <form method="POST" action="/projeto_assinatura/<%= d.id %>/delete" style="display:inline" onsubmit="return confirm('Deseja realmente remover sua assinatura desta etapa?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Remover Assinatura" style="font-size:0.75rem;">
                                                        <i class="bi bi-trash-fill"></i> Excluir
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-muted" title="<%= blockReason %>" style="font-size:0.7rem;">
                                                    <i class="bi bi-lock-fill"></i> Bloqueado
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</main>

<%- include('../rodape') %>