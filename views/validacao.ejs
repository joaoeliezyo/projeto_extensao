<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Validação de Assinatura Digital</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --success: #10b981;
            --danger: #ef4444;
            --text-dark: #1f2937;
            --text-light: #6b7280;
            --bg-gradient: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            --card-bg: rgba(255, 255, 255, 0.9);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: var(--text-dark);
        }

        .container {
            width: 100%;
            max-width: 550px;
        }

        .card {
            background: var(--card-bg);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 40px 30px;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .icon-wrapper {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 25px auto;
            font-size: 2.5rem;
            animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
        }

        .success-icon {
            background-color: rgba(16, 185, 129, 0.1);
            color: var(--success);
            border: 2px solid rgba(16, 185, 129, 0.2);
        }

        .danger-icon {
            background-color: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 2px solid rgba(239, 68, 68, 0.2);
        }

        h1 {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .success-title {
            color: var(--success);
        }

        .danger-title {
            color: var(--danger);
        }

        .subtitle {
            font-size: 0.95rem;
            color: var(--text-light);
            margin-bottom: 30px;
        }

        .details-list {
            text-align: left;
            background: rgba(243, 244, 246, 0.6);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
            border: 1px solid rgba(0, 0, 0, 0.03);
        }

        .details-item {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .details-item:last-child {
            margin-bottom: 0;
        }

        .details-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-light);
            font-weight: 600;
        }

        .details-value {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-dark);
            word-break: break-word;
        }

        .details-value.code {
            font-family: monospace;
            font-size: 1.1rem;
            color: var(--primary);
            background: rgba(79, 70, 229, 0.05);
            padding: 4px 8px;
            border-radius: 6px;
            display: inline-block;
        }

        .footer-logo {
            margin-top: 10px;
            font-size: 0.85rem;
            color: var(--text-light);
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .footer-logo img {
            height: 30px;
            object-fit: contain;
        }

        .btn {
            display: inline-block;
            width: 100%;
            padding: 12px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background-color 0.2s;
            margin-bottom: 15px;
        }

        .btn:hover {
            background-color: #4338ca;
        }

        @keyframes popIn {
            0% {
                transform: scale(0);
                opacity: 0;
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @media (max-width: 480px) {
            .card {
                padding: 30px 20px;
            }
            h1 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <% if (success) { %>
                <div class="icon-wrapper success-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h1 class="success-title">Assinatura Válida</h1>
                <p class="subtitle">Documento assinado digitalmente e verificado com sucesso.</p>

                <div class="details-list">
                    <div class="details-item">
                        <span class="details-label">Projeto de Extensão</span>
                        <span class="details-value"><%= assinatura.projeto_titulo %></span>
                    </div>
                    <div class="details-item">
                        <span class="details-label">Etapa do Projeto</span>
                        <span class="details-value"><%= typeof etapa !== 'undefined' ? etapa : 'Plano de Trabalho' %></span>
                    </div>
                    <div class="details-item">
                        <span class="details-label">Assinante</span>
                        <span class="details-value" style="text-transform: uppercase;"><%= assinatura.pessoa_nome %></span>
                    </div>
                    <div class="details-item">
                        <span class="details-label">Papel / Função</span>
                        <span class="details-value"><%= papel %></span>
                    </div>
                    <div class="details-item">
                        <span class="details-label">CPF</span>
                        <span class="details-value">
                            <% 
                            const rawCpf = assinatura.pessoa_cpf || '';
                            const clean = rawCpf.replace(/\D/g, '');
                            let masked = '***.***.***-**';
                            if (clean.length === 11) {
                                masked = '***.' + clean.substring(3, 6) + '.' + clean.substring(6, 9) + '-**';
                            }
                            %>
                            <%= masked %>
                        </span>
                    </div>
                    <div class="details-item">
                        <span class="details-label">Data e Hora</span>
                        <span class="details-value">
                            <%= new Date(assinatura.data_hora).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
                        </span>
                    </div>
                    <div class="details-item">
                        <span class="details-label">Código de Validação</span>
                        <span class="details-value code"><%= assinatura.Assinatura %></span>
                    </div>
                </div>
            <% } else { %>
                <div class="icon-wrapper danger-icon">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h1 class="danger-title">Falha na Validação</h1>
                <p class="subtitle" style="margin-bottom: 40px;"><%= message %></p>
            <% } %>

            <a href="/" class="btn">Ir para o Sistema</a>

            <div class="footer-logo">
                <span>UNI-CET Centro Universitário</span>
            </div>
        </div>
    </div>
</body>
</html>
