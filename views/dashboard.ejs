<%- include('cabecalho', { titulo: 'Dashboard' }) %>

<%
  const s = (typeof stats !== 'undefined' && stats) ? stats : {};
  const sc = s.statusCounts || {};
  const perfil = (typeof sessionTipo !== 'undefined') ? sessionTipo : '';
  const isAdmin = perfil === 'admin' || perfil === 'propec';
  const isCoord = perfil === 'coordenador';
%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Bem-vindo, <%= sessionUsuario %>!</h1>
    <p class="text-muted mb-0 helper">
      Gerenciador de Projetos de Extensão
      <span class="badge bg-secondary ms-2 badge-role"><%= perfil || 'professor' %></span>
    </p>
  </div>
  <span class="badge bg-info">
    <i class="bi bi-calendar3"></i> <%= new Date().toLocaleDateString('pt-BR') %>
  </span>
</div>

<!-- KPIs -->
<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-primary">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 kpi-label">Total de Projetos</p>
            <h2 class="mb-0 fw-bold"><%= s.totalProjetos || 0 %></h2>
          </div>
          <div class="kpi-icon-primary"><i class="bi bi-briefcase-fill"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-success">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 kpi-label">Aprovados</p>
            <h2 class="mb-0 fw-bold text-success"><%= (sc.aprovado || 0) + (sc.em_execucao || 0) + (sc.concluido || 0) %></h2>
          </div>
          <div class="kpi-icon-success"><i class="bi bi-check-circle-fill"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-warning">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 kpi-label">Em Avaliação</p>
            <h2 class="mb-0 fw-bold text-warning"><%= sc.em_avaliacao || 0 %></h2>
          </div>
          <div class="kpi-icon-warning"><i class="bi bi-hourglass-split"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-brand">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1 kpi-label">Pessoas Cadastradas</p>
            <h2 class="mb-0 fw-bold"><%= s.totalPessoas || 0 %></h2>
          </div>
          <div class="kpi-icon-brand"><i class="bi bi-people-fill"></i></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Status breakdown -->
<div class="row mb-4">
  <div class="col-md-8 mb-3">
    <div class="card">
      <div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-bar-chart"></i> Projetos por Status</h6>
        <div class="row text-center">
          <div class="col-4 col-md-2">
            <div class="status-stat-box status-stat-rascunho">
              <div class="status-stat-val"><%= sc.rascunho || 0 %></div>
              <small class="text-muted status-stat-lbl">RASCUNHO</small>
            </div>
          </div>
          <div class="col-4 col-md-2">
            <div class="status-stat-box status-stat-avaliacao">
              <div class="status-stat-val"><%= sc.em_avaliacao || 0 %></div>
              <small class="status-stat-lbl">EM AVALIAÇÃO</small>
            </div>
          </div>
          <div class="col-4 col-md-2">
            <div class="status-stat-box status-stat-aprovado">
              <div class="status-stat-val"><%= sc.aprovado || 0 %></div>
              <small class="status-stat-lbl">APROVADO</small>
            </div>
          </div>
          <div class="col-4 col-md-2">
            <div class="status-stat-box status-stat-execucao">
              <div class="status-stat-val"><%= sc.em_execucao || 0 %></div>
              <small class="status-stat-lbl">EM EXECUÇÃO</small>
            </div>
          </div>
          <div class="col-4 col-md-2">
            <div class="status-stat-box status-stat-concluido">
              <div class="status-stat-val"><%= sc.concluido || 0 %></div>
              <small class="status-stat-lbl">CONCLUÍDO</small>
            </div>
          </div>
          <div class="col-4 col-md-2">
            <div class="status-stat-box status-stat-rejeitado">
              <div class="status-stat-val"><%= sc.rejeitado || 0 %></div>
              <small class="status-stat-lbl">REJEITADO</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-mortarboard"></i> Projetos por Curso</h6>
        <% if (s.projetosPorCurso && s.projetosPorCurso.length > 0) { %>
          <% s.projetosPorCurso.forEach(c => { %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="course-item-name" title="<%= c.nome_curso %>"><%= c.nome_curso %></span>
              <span class="badge bg-primary"><%= c.total %></span>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-muted text-center helper">Nenhum curso vinculado</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Acesso Rápido -->
<h5 class="fw-bold mb-3"><i class="bi bi-lightning"></i> Acesso Rápido</h5>
<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-success">
      <div class="card-body text-center">
        <div class="card-icon success"><i class="bi bi-briefcase-fill"></i></div>
        <h5 class="card-title">Projetos</h5>
        <p class="card-text text-muted helper">Projetos de Extensão</p>
        <a href="/projeto_extensao" class="btn btn-primary btn-sm">Acessar</a>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-brand">
      <div class="card-body text-center">
        <div class="card-icon brand"><i class="bi bi-people-fill"></i></div>
        <h5 class="card-title">Pessoas</h5>
        <p class="card-text text-muted helper">Cadastro de pessoas</p>
        <a href="/pessoa" class="btn btn-primary btn-sm">Acessar</a>
      </div>
    </div>
  </div>
  <% if (isAdmin || isCoord) { %>
  <div class="col-md-3 mb-3">
    <div class="card module-card card-kpi-indigo">
      <div class="card-body text-center">
        <div class="card-icon indigo"><i class="bi bi-person-gear"></i></div>
        <h5 class="card-title">Usuários</h5>
        <p class="card-text text-muted helper">Gerenciar acessos</p>
        <a href="/usuarios" class="btn btn-primary btn-sm">Acessar</a>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card module-card">
      <div class="card-body text-center">
        <div class="card-icon brand"><i class="bi bi-gear"></i></div>
        <h5 class="card-title">Configurações</h5>
        <p class="card-text text-muted helper">Tabelas do sistema</p>
        <a href="/configuracoes" class="btn btn-outline-primary btn-sm">Gerenciar</a>
      </div>
    </div>
  </div>
  <% } %>
</div>

<div class="mt-4 pt-3 border-top text-muted text-center">
  <p class="mb-0"><small>Sistema de Projetos de Extensão - UNI-CET <%= new Date().getFullYear() %></small></p>
</div>

<%- include('rodape') %>
