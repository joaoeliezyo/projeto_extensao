<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login - UNI-CET Extensão</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="./css/styles.css">
  <link rel="stylesheet" href="/css/login.css">
</head>

<body>
  <div class="login-card">
    <div class="login-header">
      <img src="./imagens/logo-unicet.png" alt="UNI-CET">
      <h1>Sistema de Extensão</h1>
      <small>UNI-CET</small>
    </div>

    <div class="login-body">
      <div id="login-feedback-message" class="login-alert d-none" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>Credenciais inválidas.</span>
      </div>

      <form id="formulario-login" method="POST" action="/login">
        <div class="mb-3">
          <label for="campo-usuario" class="form-label">Usuário</label>
          <div class="input-group">
            <span class="input-icon"><i class="bi bi-person"></i></span>
            <input id="campo-usuario" name="username" type="text" class="form-control" required
              placeholder="Digite seu usuário" autocomplete="username" autofocus>
          </div>
        </div>

        <div class="mb-3 form-group-password">
          <label for="campo-senha" class="form-label">Senha</label>
          <div class="input-group">
            <span class="input-icon"><i class="bi bi-lock"></i></span>
            <input id="campo-senha" name="password" type="password" class="form-control" required
              placeholder="Digite sua senha" autocomplete="current-password">
            <button type="button" class="toggle-pass" onclick="togglePassword()" tabindex="-1">
              <i class="bi bi-eye" id="eye-icon"></i>
            </button>
          </div>
        </div>

        <div class="mt-4">
          <button id="botao-entrar" type="submit" class="btn-login">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
          </button>
        </div>

      </form>
    </div>

    <div class="login-footer">
      UNI-CET &copy; <%= new Date().getFullYear() %> - Extensão Acadêmica

    </div>
  </div>

  <script>
    function togglePassword() {
      var input = document.getElementById('campo-senha');
      var icon = document.getElementById('eye-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('bi-eye');
        icon.classList.add('bi-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('bi-eye-slash');
        icon.classList.add('bi-eye');
      }
    }
    // Show error message from URL param
    (function () {
      var params = new URLSearchParams(window.location.search);
      var erro = params.get('erro');
      if (erro) {
        var el = document.getElementById('login-feedback-message');
        if (el) {
          el.querySelector('span').textContent = erro;
          el.classList.remove('d-none');
        }
      }
    })();
    // Disable button on submit to prevent double-click
    document.getElementById('formulario-login').addEventListener('submit', function () {
      var btn = document.getElementById('botao-entrar');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Entrando...';
    });
  </script>
  <img src="./imagens/seloSPT.png" alt="Selo SPT" class="selo-spt">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>